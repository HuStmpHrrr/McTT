(* A client of [Prelude::Arith::Gcd], its laws, and [Prelude::Arith::Prime]:
   greatest common divisors, the primes below 30, and closed instances of
   the theorems, which normalize to [true].  The numbers in the proofs stay
   small, since they compute with remainders and equalities of numbers. *)
import Prelude::Arith::Mult use (mult)
import Prelude::Arith::Sum use (sumTo)
import Prelude::Arith::Decide use (pick)
import Prelude::Arith::Divides.Closure use (dividesMultLeft; dividesPlusCancel)
import Prelude::Function::Combinators use (Generic)
import Prelude::Arith::Gcd use (gcd)
import Prelude::Arith::Gcd::Properties.Values use (gcdZeroLeft; gcdZeroRight; gcdSelf; gcdOneRight; gcdComm)
import Prelude::Arith::Gcd::Properties.Divisor use (gcdDividesLeft; gcdDividesRight; gcdGreatest)
import Prelude::Arith::Prime use (smallestDivisor; isPrime; Prime)
import Prelude::Arith::Prime.Laws use (smallestDivisorDivides; primeGeTwo; primeSmallestDivisor)
import Prelude::Arith::Prime.Facts use (twoPrime; sevenPrime; nineNotPrime)

module NumberTheory where

eval gcd 12 18

eval gcd 17 5

eval gcd 0 9

eval gcd 9 0

(* Enumerating the primes.  The search for the next prime is a private
   helper; only [nthPrime] is exported. *)
module Primes where

(* The least prime above [n], searched among the numbers from [n + 1] to
   [2 n + 2], which contain one by Bertrand's postulate. *)
private def nextPrime (n : Nat) : Nat :=
  (rec n return y . (forall (c : Nat) -> Nat)
   | zero => fun (c : Nat) -> pick (isPrime c) (fun (u : Nat) -> succ c) (fun (u : Nat) -> c)
   | succ p, r => fun (c : Nat) -> pick (isPrime c) (fun (u : Nat) -> r (succ c)) (fun (u : Nat) -> c)
   end) (succ n)
end

(* The [k]-th prime, counting from [0]. *)
def nthPrime (k : Nat) : Nat := Generic.iterate Nat nextPrime (succ k) 0 end

end

import Primes use (nthPrime)

(* The primes below 30 are the first ten primes; the eleventh is 31. *)
eval nthPrime 0

eval nthPrime 1

eval nthPrime 2

eval nthPrime 3

eval nthPrime 4

eval nthPrime 5

eval nthPrime 6

eval nthPrime 7

eval nthPrime 8

eval nthPrime 9

eval nthPrime 10

(* There are ten primes below 30, and they add up to 129. *)
eval sumTo isPrime 30

eval sumTo (fun (i : Nat) -> mult i (isPrime i)) 30

eval smallestDivisor 91

eval smallestDivisor 29

(* Primality computes to [True] or [False]. *)
eval Prime 29

eval Prime 27

(* A proof of a closed proposition normalizes to [true], of type [True]. *)
eval gcdZeroLeft 5

eval gcdZeroRight 5

eval gcdSelf 7

eval gcdOneRight 9

eval gcdDividesLeft 6 9

eval gcdDividesRight 6 9

eval gcdGreatest 2 8 12 true true

eval gcdComm 6 9

eval dividesMultLeft 3 6 2 true

eval dividesPlusCancel 3 6 9 true true

eval twoPrime

eval sevenPrime

eval nineNotPrime

eval smallestDivisorDivides 15

eval primeGeTwo 13 true

eval primeSmallestDivisor 13 true

end
