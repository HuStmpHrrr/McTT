(* A client of [Prelude›Arith›Induction] and [Prelude›Arith›Decide]: halving by
   strong and by two-step induction, decisions eliminated into [ℕ] to show which
   branch they compute, and the equality test [eqb]. *)
module Induction where

import Prelude›Logic use (Not)
open Prelude›Logic.Disj 0l use (orElim)
open Prelude›Logic.Equiv 0l use (iffFwd; iffBwd)
open Prelude›Logic.Exist 0l use (existsIntro; existsElim)
open Prelude›Logic.Decidable 0l use (decStable)
import Prelude›Arith›Equality use (Eq)
import Prelude›Arith›Plus use (plus)
import Prelude›Arith›Order use (Le; Lt)
open Prelude›Arith›Order.LeLaws use (leSucc)
import Prelude›Arith›Parity use (Even; double)
import Prelude›Arith›Induction use (caseNat; twoStepInd; strongInd)
import Prelude›Arith›Decide use (eqb)
open Prelude›Arith›Decide.Deciders use (decEq; decLe; decLt)
open Prelude›Arith›Decide.EqbLaws use (eqbSpec; eqbZero)

(* Halving, by the two induction principles; [eval]s below compare them. *)
module Halving where

(* Halving by strong induction: [half (succ (succ q))] calls itself at [q],
   which is below [succ (succ q)] by [leSucc q].  The two case analyses
   give the result as a function of the hypothesis for all smaller numbers. *)
def half (n : ℕ) : ℕ ≔
  strongInd (λ (k : ℕ) → ℕ)
    (λ (k : ℕ) (r : ∀ (m : ℕ) (lt : Lt m k) → ℕ) →
       caseNat (λ (x : ℕ) → ∀ (r : ∀ (m : ℕ) (lt : Lt m x) → ℕ) → ℕ)
         (λ (r : ∀ (m : ℕ) (lt : Lt m 0) → ℕ) → 0)
         (λ (p : ℕ) →
            caseNat (λ (y : ℕ) → ∀ (r : ∀ (m : ℕ) (lt : Lt m (succ y)) → ℕ) → ℕ)
              (λ (r : ∀ (m : ℕ) (lt : Lt m 1) → ℕ) → 0)
              (λ (q : ℕ) (r : ∀ (m : ℕ) (lt : Lt m (succ (succ q))) → ℕ) →
                 succ (r q (leSucc q)))
              p)
         k r)
    n
end

(* Halving by two-step induction, which needs no order hypothesis. *)
def halfTwo (n : ℕ) : ℕ ≔
  twoStepInd (λ (k : ℕ) → ℕ) 0 0 (λ (k : ℕ) (h : ℕ) → succ h) n
end

end

open Halving use (half; halfTwo)

eval half 7

eval half 20

eval halfTwo 7

eval halfTwo 20

(* A closed instance of two-step induction at a proposition. *)
eval twoStepInd (λ (k : ℕ) → Even (double k)) ⋆ ⋆
       (λ (k : ℕ) (h : Even (double k)) → h) 5

(* Case analysis: the predecessor. *)
eval caseNat (λ (k : ℕ) → ℕ) 0 (λ (k : ℕ) → k) 9

(* Decisions, eliminated into [ℕ]: 1 for the positive branch, 0 for the
   negative one. *)
eval orElim (Eq 3 3) (Not (Eq 3 3)) ℕ (decEq 3 3)
       (λ (h : Eq 3 3) → 1) (λ (h : Not (Eq 3 3)) → 0)

eval orElim (Eq 3 4) (Not (Eq 3 4)) ℕ (decEq 3 4)
       (λ (h : Eq 3 4) → 1) (λ (h : Not (Eq 3 4)) → 0)

eval orElim (Le 2 5) (Not (Le 2 5)) ℕ (decLe 2 5)
       (λ (h : Le 2 5) → 1) (λ (h : Not (Le 2 5)) → 0)

eval orElim (Lt 5 5) (Not (Lt 5 5)) ℕ (decLt 5 5)
       (λ (h : Lt 5 5) → 1) (λ (h : Not (Lt 5 5)) → 0)

(* A decidable proposition is stable under double negation. *)
eval decStable (Eq 4 4) (decEq 4 4) (λ (n : Not (Eq 4 4)) → n ⋆)

eval eqb 6 6

eval eqb 6 2

(* Both directions of [eqbSpec] at closed numbers. *)
eval iffFwd (Eq (eqb 5 5) 1) (Eq 5 5) (eqbSpec 5 5) ⋆

eval iffBwd (Eq (eqb 5 5) 1) (Eq 5 5) (eqbSpec 5 5) ⋆

eval eqbZero 2 3 ⋆

(* An existence proof, eliminated into [ℕ] to recover its witness. *)
eval existsElim (λ (k : ℕ) → Eq (plus k k) 6) ℕ
       (existsIntro (λ (k : ℕ) → Eq (plus k k) 6) 3 ⋆)
       (λ (k : ℕ) (p : Eq (plus k k) 6) → k)

end
