(* A tour of the McTT surface language, one feature at a time, from the
   simplest to the most advanced; every example is checked and evaluated
   when the file is run. Run it from lib/ with
     ../_build/default/driver/mctt.exe Tutorial.mctt

   1-6    lexical matters, evaluation, functions, recursion on numbers,
          the unit and empty types, local definitions;
   7-8    definitions, their modifiers and keywords, axioms;
   9-13   modules: nesting, parameters, aliases, privacy, units, imports
          and opens, local modules;
   14     universe levels, and sorted levels;
   15-17  inductive types, the builtin natural numbers, aliases, indexed
          types, recursors;
   18-19  mutual and nested types, their eliminators and mutual
          definitions;
   20     records: values, fields through any term, eta, with-areas,
          aliases;
   21     a showcase: the algebraic hierarchy of the Prelude. *)

(* A file is one unit: one module. Its imports go inside it (section 11). *)

module Tutorial where

(* The natural numbers are the inductive type Nat of Prelude›Builtin›Nat,
   which binds it as the builtin natural numbers: the token ℕ and the
   numerals denote it. Its constructors zero and succ are members of Nat,
   and the unit exports them, so they are imported by name. *)
import Prelude›Builtin›Nat use (zero; succ)
import Prelude›Arith›Equality use (Eq; refl)
import Prelude›Function›Iter as Iter

(* 1. Lexical matters.
   This text is a comment; comments do not nest. Identifiers are letters
   only, so names are camelCase. A numeral is unary: 3 is
   succ (succ (succ zero)), and is printed back as 3.

   Symbols have a Unicode and an ASCII spelling, and either may be used
   anywhere; this file uses the Unicode ones, which the checker also prints:
     →  ->      ⇒  =>      ≔  :=      ›  ::
     λ  fun     ∀  forall (or Π)
     ⊤  True    ⊥  False   ⋆  true    ω  omega
   Identifiers are ASCII letters, so the symbols need no spaces around
   them: [λ(x:ℕ)→x] is [fun (x : ℕ) -> x]. *)

eval succ (succ (succ zero))

(* 2. Evaluation. [eval M] normalizes M and infers its type; [eval M : T]
   checks M against T first. *)

eval 3 : ℕ

(* 3. Universes and types. Type@i is the universe of level i, with
   Type@i : Type@(i+1). ℕ is in Type@0, with zero and succ. *)

eval ℕ : Type@0

eval Type@0 : Type@1

(* A function is [λ (x : A) → M]; its type is [∀ (x : A) → B],
   where B may mention x. Application is juxtaposition. Several binders
   abbreviate nested ones. *)

eval (λ (A : Type@0) (x : A) → x) ℕ 4

eval λ (A : Type@0) (x : A) → x

(* 4. Recursion. [elim n at y → T | zero ⇒ z | succ p, r ⇒ s end] is
   primitive recursion on n, the eliminator of Nat: T is the motive, which
   binds y, p the predecessor and r the result for p. The branches are named
   by the constructors. *)

eval elim 3 at y → ℕ | zero ⇒ 0 | succ p, r ⇒ succ (succ r) end

(* The motive may compute a type: here, the type of n-ary functions on ℕ. *)
eval elim 2 at y → Type@0
     | zero ⇒ ℕ
     | succ p, r ⇒ ∀ (x : ℕ) → r
     end

(* 5. Unit and empty types. ⊤ has the one element ⋆; ⊥ has none.
   [exfalso h return x . P] eliminates h : ⊥ into any type P. *)

eval ⋆ : ⊤

eval λ (h : ⊥) → exfalso h return x . ℕ

(* 6. Local definitions. [let x : A ≔ a; y ≔ b in M end] binds each name
   in the later bindings and in M. A binding is transparent, so its value
   is known while checking the rest; an unannotated one has its type
   inferred. [Eq n m], imported above, computes to ⊤ exactly when n and
   m are equal, so [⋆] proves [Eq 3 3]. *)

eval let n : ℕ ≔ 2;
         f ≔ λ (x : ℕ) → succ x;
         p : Eq (f n) 3 ≔ ⋆
     in f (f n)
     end

(* 7. Definitions. [def f (x : A) : T ≔ M end] is
   [def f : ∀ (x : A) → T ≔ λ (x : A) → M end]. A definition is
   transparent: it unfolds wherever it is used. *)

def double (n : ℕ) : ℕ ≔
  elim n at y → ℕ | zero ⇒ 0 | succ p, r ⇒ succ (succ r) end
end

eval double 3

(* An [abstract] definition is opaque: it is checked, but never unfolds, so
   its uses are stuck. *)
abstract def four : ℕ ≔ 4 end

eval double four

(* A [private] definition is usable only inside its module (section 10).
   Both modifiers combine, in either order. *)
private def helper : ℕ ≔ 1 end

private abstract def hiddenFive : ℕ ≔ 5 end

abstract private def hiddenSix : ℕ ≔ 6 end

eval succ helper

(* 8. Definition keywords. Each is [def] with modifiers implied:
   theorem, lemma = abstract; fact, remark = abstract private;
   let, given = private. [refl n] proves [Eq n n]. *)

theorem doubleTwo : Eq (double 2) 4 ≔ refl 4 end

lemma twoDouble : Eq 4 (double 2) ≔ refl 4 end

fact factTrue : ⊤ ≔ ⋆ end

remark remarkTrue : ⊤ ≔ ⋆ end

let one : ℕ ≔ 1 end

given two : ℕ ≔ 2 end

eval double two

(* A keyword takes only the modifiers it does not imply: [private theorem]
   and [abstract let] are allowed; fact and remark take none. *)
private theorem privateThm : Eq 1 1 ≔ ⋆ end

abstract let opaqueLet : ℕ ≔ 3 end

(* Rejected:
     abstract theorem t : ℕ ≔ 1 end   Error: theorem is already abstract
     private let l : ℕ ≔ 1 end        Error: let is already private
     private fact f : ℕ ≔ 1 end       Error: fact takes no modifiers *)

(* [axiom x : T] declares x with no body: it never normalizes. An axiom
   takes no modifiers ([private axiom] gives "axiom takes no modifiers"). *)
axiom k : ℕ

eval double (succ k)

(* 9. Modules. [module X where … end] groups members; [X.f] selects one,
   through any chain of nested modules. *)

module Outer where
  def base : ℕ ≔ 10 end
  module Inner where
    def next : ℕ ≔ succ base end
  end
end

eval Outer.Inner.next

(* A module with parameters abstracts every member over them. Its
   arguments follow the selection, or apply the module in parentheses. *)
module Twice (A : Type@0) (f : ∀ (a : A) → A) where
  def twice (a : A) : A ≔ f (f a) end
end

eval Twice.twice ℕ double 1

eval (Twice ℕ double).twice 1

(* [module Y ≔ E] declares an alias. Applying a module to some of its
   parameters is partial application. *)
module NatTwice ≔ Twice ℕ

module Quadruple ≔ NatTwice double

eval Quadruple.twice 1

(* [module A.B where … end] declares B inside A. *)
module Shapes.Square where
  def side : ℕ ≔ 2 end
end

eval Shapes.Square.side

(* 10. Privacy. A private member is usable inside the module that declares
   it, including its nested modules, and nowhere else. *)

module Vault where
  private def secret : ℕ ≔ 7 end
  def reveal : ℕ ≔ succ secret end
  module Inside where
    def peek : ℕ ≔ secret end
  end
end

eval Vault.reveal

eval Vault.Inside.peek

(* Rejected: eval Vault.secret   Error: Tutorial.Vault.secret is private *)

(* 11. Units, imports and opens. The unit X›Y is the file X/Y.mctt under
   a search root: the directories given by [--search-root] (the flag may
   be repeated), then those of the variable MCTT_SEARCH_ROOT, then the
   current directory, in that order. [import X›Y] only loads the unit
   X›Y: its members are reached by their full name. *)

import Prelude›Arith›Plus

eval Prelude›Arith›Plus.plus 2 3

(* [open E as Z use (a; c as d) export (e)] declares, in this module, a
   private alias [module Z ≔ E], private definitions [a ≔ Z.a] and
   [d ≔ Z.c], and a public definition [e ≔ Z.e]. Items naming a submodule
   declare aliases instead. *)

module Adding where
  open Prelude›Arith›Plus as P use (plus as add) export (Algebra)
  def five : ℕ ≔ add 2 (P.plus 1 2) end
end

eval Adding.five

eval Adding.Algebra.plusComm 1 2

(* Rejected: eval Adding.add   Error: Tutorial.Adding.add is private *)

(* The long form [import X›Y as Z use (…)] is [import X›Y] then
   [open X›Y as Z use (…)]. Prelude›Arith›Plus is loaded already, and a
   repeated import does nothing, so this one only opens it. *)

module Counting where
  import Prelude›Arith›Plus as Q use (plus)
  def seven : ℕ ≔ plus 3 (Q.plus 2 2) end
end

eval Counting.seven

(* Imports and opens may also precede the unit's header. By convention they
   are only those the unit's parameter types need; everything else is
   imported inside the module, as at the top of this file. Leading ones may
   [use] and [as] but not [export]:
     import Prelude›Arith›Equality use (Eq)
     module Proofs (h : Eq 1 1) where … end *)

(* 12. Local modules. [let module X (ps) where … end in M end] declares a
   module inside a term, and [let module X ≔ E in M end] an alias. The body
   may [open] modules and declare private members, which M cannot use.
   (Aliases and opens of types in a local module come with the next stage;
   see the end of the file.) *)

eval let module Doubler (n : ℕ) where
         open Twice ℕ double use (twice)
         private def base : ℕ ≔ twice n end
         def sum : ℕ ≔ succ base end
       end;
       module DoublerOne ≔ Doubler 1
     in DoublerOne.sum
     end

(* Rejected in a local module body:
     import X›Y     Error: import is not allowed in a local module; use open
     eval M         Error: eval is not allowed in a local module
     axiom x : T    Error: axioms are not allowed in a local module

   An abstract member, or a keyword that implies [abstract], makes the
   whole let ill-typed:
     Error: let module M1 where … end in 0 end has no inferable type

   A private member is not usable in the let's body; [Doubler.base] there
   gives:
     Error: base is private in a local module, but it is used outside it *)

(* 13. Putting it together: a parameterized module with a theorem proved by
   induction, opened in a local module and instantiated. *)

module Adder (m : ℕ) where
  def add (n : ℕ) : ℕ ≔
    elim n at y → ℕ | zero ⇒ m | succ p, r ⇒ succ r end
  end

  (* Adding n is iterating succ n times. *)
  theorem addIter (n : ℕ) :
      Eq (add n) (Iter.iter 0l ℕ (λ (x : ℕ) → succ x) n m) ≔
    elim n at y → Eq (add y) (Iter.iter 0l ℕ (λ (x : ℕ) → succ x) y m)
    | zero ⇒ refl m
    | succ p, ih ⇒ ih
    end
  end
end

eval let module Five where
         open Adder 5 use (add) export (addIter)
         def eight : ℕ ≔ add 3 end
       end
     in Five.addIter Five.eight
     end

(* 14. Universe levels. [Level] is a type, with the literals [0l], [1l], …,
   and the operations [succl] and [maxl]; levels are compared by
   normalization, so [maxl 1l (succl 2l)] is [3l]. [Type@{t}] is the
   universe at the level [t], and [Type@n] abbreviates [Type@{nl}]. *)

eval maxl 1l (succl 2l)

eval Type@{maxl 1l 2l}

(* A level-polymorphic definition takes its level as an argument. A
   function type of types of [Type@{u}] is in [Type@{u}], even for a
   variable [u]. *)
def applyTwice (u : Level) (A : Type@{u}) (f : ∀ (a : A) → A) : ∀ (a : A) → A ≔
  λ (a : A) → f (f a)
end

eval applyTwice 0l ℕ double 1

eval applyTwice 1l Type@0 (λ (A : Type@0) → ∀ (a : A) → A) ℕ

(* Cumulativity: a type of [Type@{u}] is also one of [Type@{maxl u v}]. *)
def widen (u : Level) (v : Level) (A : Type@{u}) : Type@{maxl u v} ≔ A end

(* A module may take a level, so that all its members share it: the
   Prelude's [Prelude›Function›Iter] takes [(u : Level) (A : Type@{u})],
   and [Iter.iter 0l ℕ] iterates on numbers. *)
module Pointed (u : Level) (A : Type@{u}) (a : A) where
  def point : A ≔ a end
end

eval Pointed.point 1l Type@0 ℕ

(* A Church encoding quantifies over a universe, so it lives one level up:
   the conjunction of the Prelude, [Prelude›Logic.Conj u], is in
   [Type@{succl u}]. A type quantifying over levels themselves is in
   [Type@ω], the universe at the level ω, above every [Type@{u}] with [u] in
   [Level]. *)
eval ∀ (u : Level) → Type@{u}

(* Sorted levels. The levels of [Level] are the finite ones; ω and the
   levels above it are in sorted types of levels. [Level@n] holds the
   levels below ω·(n+1), and [Level] is [Level@0]; [Level@{n}] is another
   spelling of [Level@n]. A sort is included in every larger one,
   [Level@m ⊆ Level@n] for m ≤ n, and every [Level@n] is in [Type@0].
   Beyond [0l], [1l], …, the literals are [ω], [ω + b] and [ω·a + b], with
   [*] the ASCII spelling of [·]. The Prelude stays at [Level]: its
   level-polymorphic definitions take their levels there. *)
eval ω + 1 : Level@1

eval ω·2 + 1 : Level@2

eval Level@1

(* A finite level is a level of every sort. *)
def lift (u : Level) : Level@1 ≔ u end

eval lift 3l

(* Quantifying over the levels of [Level@1] gives a type at ω·2. *)
eval (∀ (u : Level@1) → Type@{u}) : Type@{ω·2}

(* 15. Inductive types. [inductive T (ps) : Type@n where | c (x : A) … end]
   declares a type and its constructors, and [T.c] reaches a constructor.
   [elim t at z → P | c x ⇒ … end] eliminates [t]: one branch per
   constructor, in order, and a recursive argument also gives an induction
   hypothesis, named after a comma. *)

inductive Shape : Type@0 where
| dot
| line (n : ℕ)
| stack (s : Shape)
end

def size (s : Shape) : ℕ ≔
  elim s at z → ℕ | dot ⇒ 0 | line n ⇒ n | stack t, r ⇒ succ r end
end

eval size (Shape.stack (Shape.line 3))

(* The natural numbers are such a type too. Prelude›Builtin›Nat declares
   [inductive Nat] and then [builtin natural ≔ Nat], which binds it as the
   natural numbers: from then on ℕ denotes [Nat] and the numerals denote
   chains of its constructors, in every unit that imports it. A second
   binding is rejected ("the natural numbers are bound already"). *)
eval Prelude›Builtin›Nat.Nat.succ 2

(* An inductive type of another unit is reached through its import, by
   name with [use] or through an [as] alias: [L.List 0l ℕ] is a type, and
   [L.List.nil 0l ℕ] one of its elements. The parameters of the type come
   first in its constructors. A type with parameters is eliminated as
   [Shape] is: the eliminator reads the parameters off the scrutinee's
   type, so neither the motive's binder [z] nor the branches mention
   them. *)
import Prelude›Data›List as L use (List)

eval L.List.cons 0l ℕ 1 (L.List.nil 0l ℕ)

def countDown (n : ℕ) : List 0l ℕ ≔
  elim n at k → List 0l ℕ
  | zero ⇒ L.List.nil 0l ℕ
  | succ p, r ⇒ L.List.cons 0l ℕ (succ p) r
  end
end

def total (l : List 0l ℕ) : ℕ ≔
  elim l at z → ℕ | nil ⇒ 0 | cons x xs, r ⇒ Prelude›Arith›Plus.plus x r end
end

eval total (countDown 4)

(* [inductive A ≔ T ps] declares an inductive alias: [A] is [T] at those
   parameters, with [T]'s constructors, which then take no parameters. An
   alias of an alias is an alias of the same type, and an alias may leave
   some parameters to its own: [Lists u] is [List u]. *)
inductive NatList ≔ List 0l ℕ

inductive Numbers ≔ NatList

inductive Lists (u : Level) ≔ List u

def oneTwo : Numbers ≔ Numbers.cons 1 (NatList.cons 2 NatList.nil) end

eval L.Ops.length 0l ℕ oneTwo

eval Lists.nil 0l ℕ : NatList

(* [open T use (c)] declares constructors of [T] as names. The data units
   of the Prelude keep their constructors to their type, so a client opens
   the ones it uses; [Nat] and [Bool] export theirs. *)
open NatList use (nil; cons)

eval cons 3 nil

(* 16. Indexed types. A parameter right of the ":", bound by a [∀] in
   front of the sort, is non-uniform: a recursive argument may give it a
   new value. [Climb n] is a climb that starts at height [n]: it stops
   there, or steps on to a climb from [succ n]. The motive binds the
   parameter ([k]) before the scrutinee, and a branch binds the
   constructor's value of it ([m]) first. *)
inductive Climb : ∀ (n : ℕ) → Type@0 where
| stop
| step (rest : Climb (succ n))
end

(* The height a climb ends at. *)
def summit (n : ℕ) (c : Climb n) : ℕ ≔
  elim c at k z → ℕ
  | stop m ⇒ m
  | step m rest, h ⇒ h
  end
end

eval summit 0 (Climb.step 0 (Climb.step 1 (Climb.stop 2)))

(* 17. Recursors. Each inductive type [T] has the recursor [T.rec], a
   function: the level of the motive, the motive, one case per
   constructor, then the scrutinee. [elim] is its readable form. *)
eval Shape.rec 0l (λ (z : Shape) → ℕ) 0 (λ (n : ℕ) → n)
       (λ (t : Shape) (r : ℕ) → succ r) (Shape.stack (Shape.line 3))

(* 18. Mutual types. [mutual G where inductive A … with B … end end]
   declares a group of types, each in scope in the others' constructors.
   An eliminator of a group has one block per member, in member order,
   each with its motive; the scrutinee's block is marked [at] and the
   others [with], and a block's binder may be annotated with its member to
   say which block is which. *)
mutual Parity where
  inductive Even : Type@0 where
  | ezero
  | esucc (o : Odd)
  with Odd : Type@0 where
  | osucc (e : Even)
  end
end

def half (e : Parity.Even) : ℕ ≔
  elim e at (z : Parity.Even) → ℕ
    | ezero ⇒ 0
    | esucc o, h ⇒ h
  with (z : Parity.Odd) → ℕ
    | osucc e, h ⇒ succ h
  end
end

eval half (Parity.Even.esucc (Parity.Odd.osucc (Parity.Even.esucc
       (Parity.Odd.osucc Parity.Even.ezero))))

(* The group's recursor module is [Parity.Rec], with one function per
   member, [rec_Even] and [rec_Odd]: the level, a motive per member, a
   case per constructor of each member, then the scrutinee. *)
(* [half] again, at an odd number, through the recursor. *)
eval Parity.Rec.rec_Odd 0l (λ (z : Parity.Even) → ℕ) (λ (z : Parity.Odd) → ℕ)
       0 (λ (o : Parity.Odd) (h : ℕ) → h) (λ (e : Parity.Even) (h : ℕ) → succ h)
       (Parity.Odd.osucc Parity.Even.ezero)

(* [mutual def] gives one function per member, in any order, each by its
   clauses: the branches of its block, with the induction hypotheses. *)
mutual def
  evenLength (e : Parity.Even) : ℕ ≔
    | ezero ⇒ 0
    | esucc o, h ⇒ succ h
  with oddLength (o : Parity.Odd) : ℕ ≔
    | osucc e, h ⇒ succ h
end

eval oddLength (Parity.Odd.osucc (Parity.Even.esucc (Parity.Odd.osucc
       Parity.Even.ezero)))

(* 19. Nested types. A constructor may hold its own type inside another
   inductive type: a rose tree holds a list of rose trees. The occurrence
   [List Rose] is a view of the group: its eliminator has a block for the
   tree and one for the list of trees, after it, and so does a [mutual
   def]. *)
inductive Rose : Type@0 where
| node (x : ℕ) (ts : List 0l Rose)
end

def leaf (n : ℕ) : Rose ≔ Rose.node n (L.List.nil 0l Rose) end

def tree : Rose ≔
  Rose.node 1 (L.List.cons 0l Rose (leaf 2) (L.List.cons 0l Rose (leaf 3)
    (L.List.nil 0l Rose)))
end

def labels (r : Rose) : ℕ ≔
  elim r at (z : Rose) → ℕ
    | node x ts, h ⇒ Prelude›Arith›Plus.plus x h
  with (z : List 0l Rose) → ℕ
    | nil ⇒ 0
    | cons t ts, ht hts ⇒ Prelude›Arith›Plus.plus ht hts
  end
end

eval labels tree

mutual def
  nodes (r : Rose) : ℕ ≔
    | node x ts, h ⇒ succ h
  with forest (ts : List 0l Rose) : ℕ ≔
    | nil ⇒ 0
    | cons t ts, ht hts ⇒ Prelude›Arith›Plus.plus ht hts
end

eval nodes tree

(* 20. Records. [record R (ps) : Type@n where f : A; … end] declares a
   record type, each field's type seeing the fields before it, and
   [record R ps where f ≔ M; … end] is a value, its fields in order. *)
record Point : Type@0 where
  x : ℕ;
  y : ℕ
with
  (* The members of the with-area see the fields of the value. *)
  def flip : Point ≔ record Point where x ≔ y; y ≔ x end end
  def sum : ℕ ≔ Prelude›Arith›Plus.plus x y end
end

def origin : Point ≔ record Point where x ≔ 0; y ≔ 0 end end

def onDiagonal (n : ℕ) : Point ≔ record Point where x ≔ n; y ≔ n end end

def corner : Point ≔ record Point where x ≔ 3; y ≔ 5 end end

(* A field or a with-area member is selected through any term of the
   record type: a definition, a term applied, a value in parentheses. *)
eval origin.x

eval (onDiagonal 3).sum

eval (record Point where x ≔ 1; y ≔ 2 end).flip.x

(* The record type is also a module over its parameters and a value:
   [Point.flip p] is [p.flip]. *)
eval Point.flip corner

(* η: a record value is determined by its fields, so [p] and the point of
   [p.x] and [p.y] are the same, by conversion. *)
import Prelude›Logic›Leibniz 0l use (Id; idRefl)

theorem pointEta : ∀ (p : Point) →
    Id Point (record Point where x ≔ p.x; y ≔ p.y end) p ≔
  λ (p : Point) → idRefl Point p
end

theorem flipFlip : ∀ (p : Point) → Id Point p.flip.flip p ≔
  λ (p : Point) → idRefl Point p
end

(* A record may take parameters, and a field's type may depend on an
   earlier field: [Prelude›Data›Sigma] is the record of a first component
   and a second whose type depends on it. A unit with parameters declares
   it over them, and [use (Sigma)] names it at the import's arguments. *)
import Prelude›Data›Sigma 0l ℕ (λ (n : ℕ) → ℕ) as Pairs use (Sigma; pair)

def twoThree : Sigma ≔ pair 2 3 end

eval Pairs.snd twoThree

eval twoThree.snd

(* [record A ≔ R ps] declares a record alias, which, like an inductive
   alias, may leave some parameters: [SamePair A] is [Prod 0l A A]. An
   [import … use (R)] or [open … use (R)] brings a record in as both a
   type and a module, and [open q as W] makes a record value [q] a
   module. *)
import Prelude›Data›Prod use (Prod)

record NatPair ≔ Prod 0l ℕ ℕ

record SamePair (A : Type@0) ≔ Prod 0l A A

def fiveSix : NatPair ≔ record Prod 0l ℕ ℕ where fst ≔ 5; snd ≔ 6 end end

eval fiveSix.swap : SamePair ℕ

module Fields where
  open fiveSix as W
  def first : ℕ ≔ W.fst end
end

eval Fields.first

(* 21. A showcase: the algebraic hierarchy of Prelude›Algebra. Each
   structure has two records. A predicate holds its laws, over a carrier,
   a relation [eq] that the laws are stated up to, and the operations, and
   extends the predicate below by a field: [IsMonoid A eq op e] has
   [isSemigroup : IsSemigroup A eq op], which has [isMagma]. A bundle holds
   a carrier, the relation, the operations and the predicate, and its
   with-area forwards the laws, [M.assoc], with [open … export]. A
   function over every monoid takes the bundle as an argument and selects
   its members; the two levels of a monoid are those of its carrier and of
   its relation. *)
import Prelude›Algebra›Monoid 0l 0l use (Monoid)
import Prelude›Algebra›Instances›Nat as NatAlgebra
import Prelude›Algebra›Instances›Endo›Pointwise use (pointwise)

def square (M : Monoid) (a : M.carrier) : M.carrier ≔ M.op a a end

eval square NatAlgebra.additive.monoid 7

eval square NatAlgebra.multiplicative.monoid 7

eval square pointwise succ 0

(* The numbers are compared by [Eq], which computes, so a law at closed
   numbers is [⊤] and its proof normalizes to [⋆]. *)
eval NatAlgebra.additive.comm 2 3

(* The laws derived once for every monoid are a unit over the monoid:
   [pow] and [powPlus] at the multiplicative monoid are powers of
   numbers. *)
import Prelude›Algebra›Monoid›Properties 0l 0l NatAlgebra.multiplicative.monoid
  as Times

eval Times.pow 3 4

theorem powers : Eq (Times.pow 2 (Prelude›Arith›Plus.plus 1 2))
    (NatAlgebra.multiplicative.op (Times.pow 2 1) (Times.pow 2 2)) ≔
  Times.Power.powPlus 2 1 2
end

