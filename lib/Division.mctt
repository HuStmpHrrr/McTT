(* A client of [Prelude::Arith::Div] and [Prelude::Arith::Divides]: computed
   quotients and remainders, and closed instances of their theorems.  The
   second argument [d] of [div] and [mod] stands for the divisor [succ d], so
   [div 17 3] divides 17 by 4. *)
import Prelude::Arith::Div use (div; mod; divModSpec; modLt; modSmall; divSmall; modSelf; modPlusDivisor; divOne)
import Prelude::Arith::Divides use (Divides; dividesRefl; dividesZero; oneDivides; dividesPlus; dividesMult; evenDividesTwo; dividesTwoEven)

module Division where

(* 17 = 4 * 4 + 1. *)
eval div 17 3

eval mod 17 3

(* 17 = 3 * 5 + 2. *)
eval div 17 4

eval mod 17 4

eval div 20 4

eval mod 20 4

eval divModSpec 17 4

eval modLt 17 4

eval modSmall 3 4 true

eval divSmall 3 4 true

eval modSelf 6

eval modPlusDivisor 9 4

eval divOne 7

(* Divisibility computes: 3 divides 12, and does not divide 13. *)
eval Divides 3 12

eval Divides 3 13

eval dividesRefl 5

eval dividesZero 4

eval oneDivides 9

eval dividesPlus 3 6 9 true true

eval dividesMult 3 4

eval evenDividesTwo 8 true

eval dividesTwoEven 10 true

end
