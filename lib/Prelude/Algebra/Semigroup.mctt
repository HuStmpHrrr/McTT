(* Semigroups: [IsSemigroup A eq op] holds when [op] is a magma up to
   [eq], its predicate [isMagma], and associative up to [eq]; the bundle
   [Semigroup] is a carrier, a relation, an operation and that predicate.
   The with-areas forward the laws below, and the bundle's gives the
   magma, [S.magma]. *)
module Prelude›Algebra›Semigroup (l : Level) where

import Prelude›Algebra›Magma l use (IsMagma; Magma)

record IsSemigroup (A : Type@{l}) (eq : ∀ (x : A) (y : A) → Type@{l})
    (op : ∀ (x : A) (y : A) → A) : Type@{l} where
  isMagma : IsMagma A eq op;
  assoc : ∀ (x : A) (y : A) (z : A) → eq (op (op x y) z) (op x (op y z))
with
  open isMagma export (refl; sym; trans; opCong)
end

record Semigroup : Type@{succl l} where
  carrier : Type@{l};
  eq : ∀ (x : carrier) (y : carrier) → Type@{l};
  op : ∀ (x : carrier) (y : carrier) → carrier;
  isSemigroup : IsSemigroup carrier eq op
with
  open isSemigroup export (refl; sym; trans; opCong; assoc)
  def magma : Magma ≔
    record Magma where
      carrier ≔ carrier; eq ≔ eq; op ≔ op; isMagma ≔ isSemigroup.isMagma
    end
  end
end

end
