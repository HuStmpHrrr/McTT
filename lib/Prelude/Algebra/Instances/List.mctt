(* The lists over [A] under [append], with [nil] as the neutral element:
   the free monoid on [A], [freeMonoid].  [append nil l] is [l] by
   computation; the other laws are those of
   [Prelude›Data›List›Properties]. *)
module Prelude›Algebra›Instances›List (u : Level) (A : Type@{u}) where

import Prelude›Logic›Leibniz u use (idRefl)
import Prelude›Data›List use (List)
open Prelude›Data›List.Ops as Ops
import Prelude›Data›List›Properties.Append u A use (appendNil; appendAssoc)
import Prelude›Algebra›Magma u use (Magma)
import Prelude›Algebra›Semigroup u use (Semigroup)
import Prelude›Algebra›Monoid u use (Monoid)

private inductive L ≔ List u A

def freeMonoid : Monoid ≔
  record Monoid where
    semigroup ≔
      record Semigroup where
        magma ≔ record Magma where carrier ≔ L; op ≔ Ops.append u A end;
        assoc ≔ appendAssoc
      end;
    e ≔ L.nil;
    leftId ≔ λ (l : L) → idRefl L l;
    rightId ≔ appendNil
  end
end

end
