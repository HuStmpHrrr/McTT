(* The booleans as instances of the structures of [Prelude›Algebra], up to
   Leibniz equality, at the levels [0l] and [1l]: commutative monoids under
   [and] with [tt] ([conjunction]) and under [or] with [ff] ([disjunction]),
   the lattice of [and] and [or] ([andOr]), and the boolean ring of [xor]
   and [and] ([ring]), in which every element is its own negative.  The
   laws are those of [Prelude›Data›Bool›Properties]; [and tt b] is [b] and
   [or ff b] is [b] by computation.  Each magma predicate is
   [idIsMagma Bool op], and the predicates of [and], [or] and [xor] are
   named, so that the lattice and the ring reuse them. *)
module Prelude›Algebra›Instances›Bool where

import Prelude›Logic›Leibniz 0l use (Id; idRefl)
import Prelude›Data›Bool use (Bool; tt; ff; and; or; xor)
import Prelude›Data›Bool›Properties
open Prelude›Data›Bool›Properties.Conj
  use (andIdentityRight; andZeroRight; andComm; andAssoc; andIdem)
open Prelude›Data›Bool›Properties.Disj
  use (orIdentityRight; orComm; orAssoc; orIdem)
open Prelude›Data›Bool›Properties.DeMorgan use (andAbsorbsOr; orAbsorbsAnd)
open Prelude›Data›Bool›Properties.Xor
  use (xorIdentityRight; xorSelf; xorComm; xorAssoc; andXorDistribLeft;
       andXorDistribRight)
import Prelude›Algebra›Leibniz 0l use (idIsMagma)
import Prelude›Algebra›Semigroup 0l 1l use (IsSemigroup)
import Prelude›Algebra›Monoid 0l 1l use (IsMonoid)
import Prelude›Algebra›CommutativeMonoid 0l 1l
  use (IsCommutativeMonoid; CommutativeMonoid)
import Prelude›Algebra›Semilattice 0l 1l use (IsSemilattice)
import Prelude›Algebra›Lattice 0l 1l use (IsLattice; Lattice)
import Prelude›Algebra›Semiring 0l 1l use (IsSemiring)
import Prelude›Algebra›Ring 0l 1l use (IsRing; Ring)

(* An associative operation on booleans. *)
private def semigroupOf (op : ∀ (a : Bool) (b : Bool) → Bool)
    (assoc : ∀ (a : Bool) (b : Bool) (c : Bool) →
               Id Bool (op (op a b) c) (op a (op b c))) :
    IsSemigroup Bool (Id Bool) op ≔
  record IsSemigroup Bool (Id Bool) op where
    isMagma ≔ idIsMagma Bool op; assoc ≔ assoc
  end
end

def andIsCommutativeMonoid : IsCommutativeMonoid Bool (Id Bool) and tt ≔
  record IsCommutativeMonoid Bool (Id Bool) and tt where
    isMonoid ≔
      record IsMonoid Bool (Id Bool) and tt where
        isSemigroup ≔ semigroupOf and andAssoc;
        leftId ≔ idRefl Bool;
        rightId ≔ andIdentityRight
      end;
    comm ≔ andComm
  end
end

def orIsCommutativeMonoid : IsCommutativeMonoid Bool (Id Bool) or ff ≔
  record IsCommutativeMonoid Bool (Id Bool) or ff where
    isMonoid ≔
      record IsMonoid Bool (Id Bool) or ff where
        isSemigroup ≔ semigroupOf or orAssoc;
        leftId ≔ idRefl Bool;
        rightId ≔ orIdentityRight
      end;
    comm ≔ orComm
  end
end

def xorIsCommutativeMonoid : IsCommutativeMonoid Bool (Id Bool) xor ff ≔
  record IsCommutativeMonoid Bool (Id Bool) xor ff where
    isMonoid ≔
      record IsMonoid Bool (Id Bool) xor ff where
        isSemigroup ≔ semigroupOf xor xorAssoc;
        leftId ≔ idRefl Bool;
        rightId ≔ xorIdentityRight
      end;
    comm ≔ xorComm
  end
end

def conjunction : CommutativeMonoid ≔
  record CommutativeMonoid where
    carrier ≔ Bool; eq ≔ Id Bool; op ≔ and; e ≔ tt;
    isCommutativeMonoid ≔ andIsCommutativeMonoid
  end
end

def disjunction : CommutativeMonoid ≔
  record CommutativeMonoid where
    carrier ≔ Bool; eq ≔ Id Bool; op ≔ or; e ≔ ff;
    isCommutativeMonoid ≔ orIsCommutativeMonoid
  end
end

(* The lattice of [and] and [or]: [Le a b], [and a b = a], is implication. *)
def andOr : Lattice ≔
  record Lattice where
    carrier ≔ Bool; eq ≔ Id Bool; meet ≔ and; join ≔ or;
    isLattice ≔
      record IsLattice Bool (Id Bool) and or where
        meetIsSemilattice ≔
          record IsSemilattice Bool (Id Bool) and where
            isSemigroup ≔ semigroupOf and andAssoc; comm ≔ andComm; idem ≔ andIdem
          end;
        joinIsSemilattice ≔
          record IsSemilattice Bool (Id Bool) or where
            isSemigroup ≔ semigroupOf or orAssoc; comm ≔ orComm; idem ≔ orIdem
          end;
        absorbMeet ≔ andAbsorbsOr;
        absorbJoin ≔ orAbsorbsAnd
      end
  end
end

(* The boolean ring: [xor] is the addition, with [ff] as zero, and [and]
   the multiplication, with [tt] as one; every element is its own
   negative, and [and ff b] is [ff] by computation. *)
def ring : Ring ≔
  record Ring where
    carrier ≔ Bool; eq ≔ Id Bool; plus ≔ xor; mul ≔ and; zero ≔ ff; one ≔ tt;
    neg ≔ λ (b : Bool) → b;
    isRing ≔
      record IsRing Bool (Id Bool) xor and ff tt (λ (b : Bool) → b) where
        isSemiring ≔
          record IsSemiring Bool (Id Bool) xor and ff tt where
            plusIsCommutativeMonoid ≔ xorIsCommutativeMonoid;
            mulIsMonoid ≔ andIsCommutativeMonoid.isMonoid;
            distribLeft ≔ andXorDistribLeft;
            distribRight ≔ andXorDistribRight;
            zeroLeft ≔ λ (b : Bool) → idRefl Bool ff;
            zeroRight ≔ andZeroRight
          end;
        negCong ≔ λ (a : Bool) (b : Bool) (h : Id Bool a b) → h;
        negLeft ≔ xorSelf
      end
  end
end

end
