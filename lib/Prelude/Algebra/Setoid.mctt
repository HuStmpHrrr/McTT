(* Setoids: [IsEquivalence A eq] holds when [eq] is reflexive, symmetric
   and transitive, and the bundle [Setoid] is a carrier with such a
   relation.  Every structure of [Prelude›Algebra] states its laws up to a
   relation [eq], so that a quotient-like carrier, as the integers as
   differences of numbers in [Prelude›Algebra›Integers], is an instance,
   and so is the Leibniz equality of [Prelude›Logic›Leibniz], through
   [Prelude›Algebra›Leibniz].

   Each unit of the hierarchy takes one level [l], of both the carrier,
   [A : Type@{l}], and the relation, [eq : A → A → Type@{l}].  A carrier
   and a relation at different levels are both at the larger one, by
   cumulativity.  The equality of numbers [Eq] and the relation [Same] of
   [Prelude›Algebra›Integers] are at the level of their carrier, [0l]; the
   Leibniz equality of a type of [Type@{u}] lives one level up, so a
   Leibniz instance is at [succl u], where the carrier is too.  A
   predicate lives in [Type@{l}] and a bundle in [Type@{succl l}]. *)
module Prelude›Algebra›Setoid (l : Level) where

record IsEquivalence (A : Type@{l}) (eq : ∀ (x : A) (y : A) → Type@{l}) :
    Type@{l} where
  refl : ∀ (x : A) → eq x x;
  sym : ∀ (x : A) (y : A) (h : eq x y) → eq y x;
  trans : ∀ (x : A) (y : A) (z : A) (hxy : eq x y) (hyz : eq y z) → eq x z
end

record Setoid : Type@{succl l} where
  carrier : Type@{l};
  eq : ∀ (x : carrier) (y : carrier) → Type@{l};
  isEquivalence : IsEquivalence carrier eq
with
  open isEquivalence export (refl; sym; trans)
end

end
