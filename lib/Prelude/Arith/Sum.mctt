(* Finite sums [sumTo f n] of [f i] for [i < n], with linearity laws, sums
   of constants, and the closed forms of Gauss and of the odd numbers. *)
import Prelude::Arith::Equality use (Eq; refl; sym; trans; cong)
import Prelude::Arith::Plus use (plus; plusZero; plusAssoc; plusSwapMiddle)
import Prelude::Arith::Mult use (mult; multZero; multSucc; multComm; multDistribLeft; multDistribRight)
import Prelude::Function::Combinators use (Generic)

module Prelude::Arith::Sum where

(* [sumTo f n] is [f (n - 1) + ... + f 0]: [sumTo f 0] is [0] and
   [sumTo f (succ p)] is [plus (f p) (sumTo f p)]. *)
def sumTo (f : forall (i : Nat) -> Nat) (n : Nat) : Nat :=
  rec n return y . Nat
  | zero => 0
  | succ p, r => plus (f p) r
  end
end

def sumToZero : forall (f : forall (i : Nat) -> Nat) -> Eq (sumTo f 0) 0 :=
  fun (f : forall (i : Nat) -> Nat) -> true
end

def sumToSucc : forall (f : forall (i : Nat) -> Nat) (n : Nat) ->
    Eq (sumTo f (succ n)) (plus (f n) (sumTo f n)) :=
  fun (f : forall (i : Nat) -> Nat) (n : Nat) -> refl (plus (f n) (sumTo f n))
end

(* Pointwise equal functions have equal sums. *)
def sumToExt : forall (f : forall (i : Nat) -> Nat) (g : forall (i : Nat) -> Nat)
    (h : forall (i : Nat) -> Eq (f i) (g i)) (n : Nat) -> Eq (sumTo f n) (sumTo g n) :=
  fun (f : forall (i : Nat) -> Nat) (g : forall (i : Nat) -> Nat)
      (h : forall (i : Nat) -> Eq (f i) (g i)) (n : Nat) ->
    rec n return x . Eq (sumTo f x) (sumTo g x)
    | zero => true
    | succ p, ih =>
        let sf : Nat := sumTo f p;
            sg : Nat := sumTo g p
        in trans (plus (f p) sf) (plus (g p) sf) (plus (g p) sg)
             (cong (fun (y : Nat) -> plus y sf) (f p) (g p) (h p))
             (cong (fun (y : Nat) -> plus (g p) y) sf sg ih)
        end
    end
end

(* Summation is additive in the summand. *)
def sumToPlus : forall (f : forall (i : Nat) -> Nat) (g : forall (i : Nat) -> Nat) (n : Nat) ->
    Eq (sumTo (fun (i : Nat) -> plus (f i) (g i)) n) (plus (sumTo f n) (sumTo g n)) :=
  fun (f : forall (i : Nat) -> Nat) (g : forall (i : Nat) -> Nat) (n : Nat) ->
    rec n return x . Eq (sumTo (fun (i : Nat) -> plus (f i) (g i)) x)
                        (plus (sumTo f x) (sumTo g x))
    | zero => true
    | succ p, ih =>
        let fg : Nat := plus (f p) (g p);
            sfg : Nat := sumTo (fun (i : Nat) -> plus (f i) (g i)) p;
            sf : Nat := sumTo f p;
            sg : Nat := sumTo g p;
            step : Eq (plus fg sfg) (plus fg (plus sf sg)) :=
              cong (fun (y : Nat) -> plus fg y) sfg (plus sf sg) ih
        in trans (plus fg sfg) (plus fg (plus sf sg)) (plus (plus (f p) sf) (plus (g p) sg))
             step (plusSwapMiddle (f p) (g p) sf sg)
        end
    end
end

(* A constant factor can be taken out of a sum. *)
def sumToScale : forall (c : Nat) (f : forall (i : Nat) -> Nat) (n : Nat) ->
    Eq (sumTo (fun (i : Nat) -> mult c (f i)) n) (mult c (sumTo f n)) :=
  fun (c : Nat) (f : forall (i : Nat) -> Nat) (n : Nat) ->
    rec n return x . Eq (sumTo (fun (i : Nat) -> mult c (f i)) x) (mult c (sumTo f x))
    | zero => sym (mult c 0) 0 (multZero c)
    | succ p, ih =>
        let cf : Nat := mult c (f p);
            scf : Nat := sumTo (fun (i : Nat) -> mult c (f i)) p;
            sf : Nat := sumTo f p;
            step : Eq (plus cf scf) (plus cf (mult c sf)) :=
              cong (fun (y : Nat) -> plus cf y) scf (mult c sf) ih
        in trans (plus cf scf) (plus cf (mult c sf)) (mult c (plus (f p) sf))
             step (sym (mult c (plus (f p) sf)) (plus cf (mult c sf))
                     (multDistribLeft c (f p) sf))
        end
    end
end

(* The sum of [n] copies of [c] is [mult n c]. *)
def sumToConst : forall (c : Nat) (n : Nat) ->
    Eq (sumTo (Generic.const Nat Nat c) n) (mult n c) :=
  fun (c : Nat) (n : Nat) ->
    rec n return x . Eq (sumTo (Generic.const Nat Nat c) x) (mult x c)
    | zero => true
    | succ p, ih =>
        cong (fun (y : Nat) -> plus c y) (sumTo (Generic.const Nat Nat c) p) (mult p c) ih
    end
end

(* Gauss: twice [0 + 1 + ... + n] is [n (n + 1)].  The step distributes
   [mult 2] over the new summand and collects [mult (succ (succ p)) (succ p)]. *)
def gauss : forall (n : Nat) ->
    Eq (mult 2 (sumTo (Generic.id Nat) (succ n))) (mult n (succ n)) :=
  fun (n : Nat) ->
    rec n return x . Eq (mult 2 (sumTo (Generic.id Nat) (succ x))) (mult x (succ x))
    | zero => true
    | succ p, ih =>
        let s : Nat := sumTo (Generic.id Nat) (succ p);
            q : Nat := succ p;
            lhs : Nat := mult 2 (plus q s);
            dist : Nat := plus (mult 2 q) (mult 2 s);
            mid : Nat := plus (mult 2 q) (mult p q);
            coll : Nat := mult (succ q) q;
            rhs : Nat := mult q (succ q);
            stepA : Eq lhs dist := multDistribLeft 2 q s;
            stepB : Eq dist mid := cong (fun (y : Nat) -> plus (mult 2 q) y) (mult 2 s) (mult p q) ih;
            stepC : Eq mid coll := sym coll mid (multDistribRight 2 p q);
            stepD : Eq coll rhs := multComm (succ q) q
        in trans lhs dist rhs stepA
             (trans dist mid rhs stepB (trans mid coll rhs stepC stepD))
        end
    end
end

(* The sum of the first [n] odd numbers [1 + 3 + ... + (2 n - 1)] is
   [mult n n].  The step reduces to
   [plus (mult 2 p) (mult p p) = plus p (mult p (succ p))]. *)
def sumOdd : forall (n : Nat) ->
    Eq (sumTo (fun (i : Nat) -> succ (mult 2 i)) n) (mult n n) :=
  fun (n : Nat) ->
    rec n return x . Eq (sumTo (fun (i : Nat) -> succ (mult 2 i)) x) (mult x x)
    | zero => true
    | succ p, ih =>
        let s : Nat := sumTo (fun (i : Nat) -> succ (mult 2 i)) p;
            pp : Nat := mult p p;
            lhs : Nat := plus (mult 2 p) s;
            a : Nat := plus (mult 2 p) pp;
            b : Nat := plus p (plus (plus p 0) pp);
            c : Nat := plus p (plus p pp);
            rhs : Nat := plus p (mult p (succ p));
            stepA : Eq lhs a := cong (fun (y : Nat) -> plus (mult 2 p) y) s pp ih;
            stepB : Eq a b := plusAssoc p (plus p 0) pp;
            stepC : Eq b c :=
              cong (fun (y : Nat) -> plus p (plus y pp)) (plus p 0) p (plusZero p);
            stepD : Eq c rhs :=
              cong (fun (y : Nat) -> plus p y) (plus p pp) (mult p (succ p))
                (sym (mult p (succ p)) (plus p pp) (multSucc p p))
        in trans lhs a rhs stepA
             (trans a b rhs stepB (trans b c rhs stepC stepD))
        end
    end
end

end
