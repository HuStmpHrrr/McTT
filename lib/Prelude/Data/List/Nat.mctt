(* Lists of numbers, [List 0l ℕ] of [Prelude›Data›List]: their [sum].  The
   laws are in [Prelude›Data›List›Nat›Properties]. *)
module Prelude›Data›List›Nat where

import Prelude›Builtin›Nat
import Prelude›Arith›Plus use (plus)
import Prelude›Data›List use (List)

(* The sum of a list of numbers. *)
def sum (l : List 0l ℕ) : ℕ ≔
  elim l return z . ℕ
  | nil ⇒ 0
  | cons x xs, r ⇒ plus x r
  end
end

end
