(* Laws of [Prelude::Data::Church], at every level [u]: the arithmetic of
   numerals agrees with that of [Nat], moving between levels keeps the
   number, and the length and sum of lists.

   A Church numeral is any function of the right type, and without
   parametricity nothing can be said of an arbitrary one.  So the laws are
   about the numerals of numbers, [fromNat u n], and are proved by induction
   on [n].  Laws that only unfold definitions, like [lengthMap], hold for
   every list. *)
module Prelude::Data::Church::Properties where

import Prelude::Arith::Equality use (Eq; refl; sym; trans; cong)
import Prelude::Arith::Plus use (plus)
open Prelude::Arith::Plus.Basic use (plusZero)
open Prelude::Arith::Plus.Algebra use (plusAssoc)
import Prelude::Arith::Mult use (mult)
import Prelude::Arith::Pow use (pow)
import Prelude::Data::Church as C

(* The successor on numbers, the function [toNat] iterates. *)
private def S (k : Nat) : Nat := succ k end

(* Numerals of numbers. *)
module Numerals where

theorem toNatFromNat : forall (u : Level) (n : Nat) -> Eq (C.toNat u (C.fromNat u n)) n :=
  fun (u : Level) (n : Nat) ->
    rec n return x . Eq (C.toNat u (C.fromNat u x)) x
    | zero => true
    | succ p, ih => ih
    end
end

(* The numeral of [m], iterating the successor from [y], adds [m]. *)
theorem fromNatAdds : forall (u : Level) (m : Nat) (y : Nat) ->
    Eq (C.fromNat u m Nat S y) (plus m y) :=
  fun (u : Level) (m : Nat) (y : Nat) ->
    rec m return x . Eq (C.fromNat u x Nat S y) (plus x y)
    | zero => refl y
    | succ p, ih => ih
    end
end

(* If [g] adds [c], then the numeral of [m], iterating [g] from [y], adds
   [m] times [c]. *)
theorem fromNatAddsMult : forall (u : Level) (c : Nat) (g : forall (k : Nat) -> Nat)
    (hg : forall (k : Nat) -> Eq (g k) (plus c k)) (m : Nat) (y : Nat) ->
    Eq (C.fromNat u m Nat g y) (plus (mult m c) y) :=
  fun (u : Level) (c : Nat) (g : forall (k : Nat) -> Nat)
      (hg : forall (k : Nat) -> Eq (g k) (plus c k)) (m : Nat) (y : Nat) ->
    rec m return x . Eq (C.fromNat u x Nat g y) (plus (mult x c) y)
    | zero => refl y
    | succ p, ih =>
        let r := C.fromNat u p Nat g y
        in trans (g r) (plus c r) (plus (mult (succ p) c) y)
             (hg r)
             (trans (plus c r) (plus c (plus (mult p c) y)) (plus (plus c (mult p c)) y)
                (cong (fun (k : Nat) -> plus c k) r (plus (mult p c) y) ih)
                (sym (plus (plus c (mult p c)) y) (plus c (plus (mult p c) y))
                   (plusAssoc c (mult p c) y)))
        end
    end
end

end

open Numerals use (toNatFromNat; fromNatAdds; fromNatAddsMult)

(* The operations on numerals compute the operations on numbers. *)
module Arithmetic where

theorem toNatPlus : forall (u : Level) (m : Nat) (n : Nat) ->
    Eq (C.toNat u (C.cplus u (C.fromNat u m) (C.fromNat u n))) (plus m n) :=
  fun (u : Level) (m : Nat) (n : Nat) ->
    let k := C.toNat u (C.fromNat u n)
    in trans (C.fromNat u m Nat S k) (plus m k) (plus m n)
         (fromNatAdds u m k)
         (cong (fun (j : Nat) -> plus m j) k n (toNatFromNat u n))
    end
end

theorem toNatMult : forall (u : Level) (m : Nat) (n : Nat) ->
    Eq (C.toNat u (C.cmult u (C.fromNat u m) (C.fromNat u n))) (mult m n) :=
  fun (u : Level) (m : Nat) (n : Nat) ->
    trans (C.fromNat u m Nat (C.fromNat u n Nat S) 0) (plus (mult m n) 0) (mult m n)
      (fromNatAddsMult u n (C.fromNat u n Nat S) (fromNatAdds u n) m 0)
      (plusZero (mult m n))
end

(* The numeral [cpow u (fromNat u m) (fromNat (succl u) k)] adds [pow m k]
   when it iterates the successor.  The induction is on [k], with the
   starting point general, so the step can use [fromNatAddsMult]. *)
theorem cpowAdds : forall (u : Level) (m : Nat) (k : Nat) (y : Nat) ->
    Eq (C.cpow u (C.fromNat u m) (C.fromNat (succl u) k) Nat S y) (plus (pow m k) y) :=
  fun (u : Level) (m : Nat) (k : Nat) ->
    rec k return x . (forall (y : Nat) ->
        Eq (C.cpow u (C.fromNat u m) (C.fromNat (succl u) x) Nat S y) (plus (pow m x) y))
    | zero => fun (y : Nat) -> refl (succ y)
    | succ p, ih => fun (y : Nat) ->
        fromNatAddsMult u (pow m p) (C.cpow u (C.fromNat u m) (C.fromNat (succl u) p) Nat S)
          ih m y
    end
end

theorem toNatPow : forall (u : Level) (m : Nat) (k : Nat) ->
    Eq (C.toNat u (C.cpow u (C.fromNat u m) (C.fromNat (succl u) k))) (pow m k) :=
  fun (u : Level) (m : Nat) (k : Nat) ->
    trans (C.toNat u (C.cpow u (C.fromNat u m) (C.fromNat (succl u) k))) (plus (pow m k) 0)
      (pow m k)
      (cpowAdds u m k 0) (plusZero (pow m k))
end

end

(* Moving between levels keeps the number. *)
module Levels where

theorem toNatLower : forall (u : Level) (n : Nat) ->
    Eq (C.toNat u (C.lower u (C.fromNat (succl u) n))) n :=
  fun (u : Level) (n : Nat) ->
    rec n return x . Eq (C.toNat u (C.lower u (C.fromNat (succl u) x))) x
    | zero => true
    | succ p, ih => ih
    end
end

theorem toNatRaise : forall (u : Level) (n : C.Numeral u) ->
    Eq (C.toNat (succl u) (C.raise u n)) (C.toNat u n) :=
  fun (u : Level) (n : C.Numeral u) -> toNatFromNat (succl u) (C.toNat u n)
end

(* [isZero] answers [cfalse] on every successor numeral, by conversion. *)
theorem isZeroSucc : forall (u : Level) (n : C.Numeral (succl u)) ->
    Eq (C.boolToNat u (C.isZero u (C.csucc (succl u) n))) 0 :=
  fun (u : Level) (n : C.Numeral (succl u)) -> true
end

end

(* Length and sum of lists. *)
module Lists where

(* Mapping keeps the length of every list, by conversion. *)
theorem lengthMap : forall (u : Level) (A : Type@{u}) (B : Type@{u}) (f : forall (a : A) -> B)
    (l : C.List u A) -> Eq (C.length u B (C.map u A B f l)) (C.length u A l) :=
  fun (u : Level) (A : Type@{u}) (B : Type@{u}) (f : forall (a : A) -> B) (l : C.List u A) ->
    refl (C.length u A l)
end

theorem lengthReplicate : forall (u : Level) (A : Type@{u}) (n : Nat) (a : A) ->
    Eq (C.length u A (C.replicate u A n a)) n :=
  fun (u : Level) (A : Type@{u}) (n : Nat) (a : A) ->
    rec n return x . Eq (C.length u A (C.replicate u A x a)) x
    | zero => true
    | succ p, ih => ih
    end
end

(* Appending [n] copies of [a] in front adds [n] to the length. *)
theorem lengthAppendReplicate : forall (u : Level) (A : Type@{u}) (n : Nat) (a : A)
    (l : C.List u A) ->
    Eq (C.length u A (C.append u A (C.replicate u A n a) l)) (plus n (C.length u A l)) :=
  fun (u : Level) (A : Type@{u}) (n : Nat) (a : A) (l : C.List u A) ->
    rec n return x . Eq (C.length u A (C.append u A (C.replicate u A x a) l))
                        (plus x (C.length u A l))
    | zero => refl (C.length u A l)
    | succ p, ih => ih
    end
end

theorem sumReplicate : forall (u : Level) (n : Nat) (c : Nat) ->
    Eq (C.sum u (C.replicate u Nat n c)) (mult n c) :=
  fun (u : Level) (n : Nat) (c : Nat) ->
    rec n return x . Eq (C.sum u (C.replicate u Nat x c)) (mult x c)
    | zero => true
    | succ p, ih =>
        cong (fun (k : Nat) -> plus c k) (C.sum u (C.replicate u Nat p c)) (mult p c) ih
    end
end

end

end
