(* Laws of [Prelude›Data›Prod] over fixed component types [A] and [B] of
   [Type@{u}], stated with the Leibniz equality of [Prelude›Logic›Leibniz]:
   the projections and surjective pairing, [swap] is an involution,
   [assoc] and [unassoc] are inverse, [map] is a functor in both
   components, and currying is inverse to uncurrying.

   [Prod] is a record, and records have eta: a pair [p] is convertible to
   [pair u A B p.fst p.snd].  Every operation computes to a [pair] of
   projections, so each law holds by [idRefl], with no case analysis. *)
module Prelude›Data›Prod›Properties (u : Level) (A : Type@{u}) (B : Type@{u})
    where

import Prelude›Data›Prod use (Prod; pair)
open Prelude›Data›Prod.Ops as P
import Prelude›Logic›Leibniz u use (Id; idRefl)

private record AB ≔ Prod u A B

private module Op ≔ P u A B

(* The projections and surjective pairing. *)
module Projections where

theorem fstPair : ∀ (a : A) (b : B) → Id A (Op.fst (pair u A B a b)) a ≔
  λ (a : A) (b : B) → idRefl A a
end

theorem sndPair : ∀ (a : A) (b : B) → Id B (Op.snd (pair u A B a b)) b ≔
  λ (a : A) (b : B) → idRefl B b
end

(* Surjective pairing: a pair is the pair of its projections, by eta. *)
theorem pairEta : ∀ (p : AB) → Id AB (pair u A B (Op.fst p) (Op.snd p)) p ≔
  λ (p : AB) → idRefl AB p
end

end

(* [swap] is an involution that exchanges the projections. *)
module Swap where

theorem swapSwap : ∀ (p : AB) → Id AB (P.swap u B A (Op.swap p)) p ≔
  λ (p : AB) → idRefl AB p
end

theorem fstSwap : ∀ (p : AB) → Id B (P.fst u B A (Op.swap p)) (Op.snd p) ≔
  λ (p : AB) → idRefl B p.snd
end

end

(* The reassociations are inverse. *)
module Assoc where

theorem unassocAssoc : ∀ (C : Type@{u}) (p : Prod u AB C) →
    Id (Prod u AB C) (Op.unassoc C (Op.assoc C p)) p ≔
  λ (C : Type@{u}) (p : Prod u AB C) → idRefl (Prod u AB C) p
end

theorem assocUnassoc : ∀ (C : Type@{u}) (p : Prod u A (Prod u B C)) →
    Id (Prod u A (Prod u B C)) (Op.assoc C (Op.unassoc C p)) p ≔
  λ (C : Type@{u}) (p : Prod u A (Prod u B C)) →
    idRefl (Prod u A (Prod u B C)) p
end

end

(* [map] is a functor in both components. *)
module Maps where

theorem mapId : ∀ (p : AB) →
    Id AB (Op.map A B (λ (a : A) → a) (λ (b : B) → b) p) p ≔
  λ (p : AB) → idRefl AB p
end

theorem mapComp : ∀ (C : Type@{u}) (D : Type@{u}) (E : Type@{u})
    (F : Type@{u}) (f : ∀ (a : A) → C) (g : ∀ (b : B) → D)
    (h : ∀ (c : C) → E) (k : ∀ (d : D) → F) (p : AB) →
    Id (Prod u E F) (P.map u C D E F h k (Op.map C D f g p))
      (Op.map E F (λ (a : A) → h (f a)) (λ (b : B) → k (g b)) p) ≔
  λ (C : Type@{u}) (D : Type@{u}) (E : Type@{u}) (F : Type@{u})
    (f : ∀ (a : A) → C) (g : ∀ (b : B) → D)
    (h : ∀ (c : C) → E) (k : ∀ (d : D) → F) (p : AB) →
    idRefl (Prod u E F) (pair u E F (h (f p.fst)) (k (g p.snd)))
end

end

(* Uncurrying a curried function gives it back, on every pair: by eta,
   [f (pair u A B p.fst p.snd)] is [f p]. *)
module Currying where

theorem uncurryCurry : ∀ (C : Type@{u}) (f : ∀ (p : AB) → C) (p : AB) →
    Id C (Op.uncurry C (Op.curry C f) p) (f p) ≔
  λ (C : Type@{u}) (f : ∀ (p : AB) → C) (p : AB) → idRefl C (f p)
end

end

end
