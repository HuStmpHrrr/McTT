(* Signs, after Agda's [Data.Sign]: [negative] and [positive] (Agda's [-]
   and [+]), with the opposite sign and the multiplication of signs, under
   which they form a group with unit [positive].  The laws are in
   [Prelude›Data›Sign›Properties]. *)
module Prelude›Data›Sign where

inductive Sign : Type@0 where
| negative
| positive
end

open Sign export (negative; positive)

def opposite (s : Sign) : Sign ≔
  elim s return z . Sign | negative ⇒ positive | positive ⇒ negative end
end

(* The sign of a product: [mul positive t] is [t], [mul negative t] is
   [opposite t]. *)
def mul (s : Sign) (t : Sign) : Sign ≔
  elim s return z . Sign | negative ⇒ opposite t | positive ⇒ t end
end

end
