(* A client of [Prelude::Algebra::Monoid] and its instances.  The laws of
   powers are proved once, for every monoid; read in the additive, the
   multiplicative and the composition monoid, they become laws of
   multiplication, of exponentiation and of iteration. *)
module Algebra where

import Prelude::Arith::Equality use (Eq; refl; sym; trans)
import Prelude::Arith::Plus use (plus)
open Prelude::Arith::Plus.Basic use (plusZero)
open Prelude::Arith::Plus.Algebra use (plusAssoc; plusCongBoth)
import Prelude::Arith::Mult use (mult)
import Prelude::Arith::Pow use (pow)
import Prelude::Arith::MinMax use (max)
open Prelude::Arith::MinMax.Laws use (maxIdem; maxZero)
import Prelude::Algebra::Monoid as Monoid
import Prelude::Algebra::Instances use (Additive; AdditiveComm; Multiplicative; MultiplicativeComm; Maximum; Composition; Endo; Pointwise; compose)

(* Powers in each monoid. *)
eval Additive.pow 3 4

eval Multiplicative.pow 2 5

eval Maximum.pow 7 3

eval Composition.pow (fun (x : Nat) -> succ (succ x)) 5 0

(* The powers of the additive and multiplicative monoids are multiplication
   and exponentiation, by conversion. *)
module Unfold where

abstract def additivePow : forall (x : Nat) (n : Nat) -> Eq (Additive.pow x n) (mult n x) :=
  fun (x : Nat) (n : Nat) -> refl (mult n x)
end

abstract def multiplicativePow : forall (x : Nat) (n : Nat) -> Eq (Multiplicative.pow x n) (pow x n) :=
  fun (x : Nat) (n : Nat) -> refl (pow x n)
end

end

(* Laws of multiplication, as laws of powers in the additive monoid. *)
module Scaling where

(* Right distributivity is [powPlus]. *)
abstract def multPlusRight : forall (m : Nat) (n : Nat) (x : Nat) ->
    Eq (mult (plus m n) x) (plus (mult m x) (mult n x)) :=
  fun (m : Nat) (n : Nat) (x : Nat) -> Additive.Power.powPlus x m n
end

(* Associativity is [powMult]. *)
abstract def multAssocPow : forall (m : Nat) (n : Nat) (x : Nat) ->
    Eq (mult (mult m n) x) (mult m (mult n x)) :=
  fun (m : Nat) (n : Nat) (x : Nat) -> Additive.Power.powMult x m n
end

(* Left distributivity needs commutativity of addition: it is [powOp] in
   the commutative instance. *)
abstract def multPlusLeft : forall (n : Nat) (x : Nat) (y : Nat) ->
    Eq (mult n (plus x y)) (plus (mult n x) (mult n y)) :=
  fun (n : Nat) (x : Nat) (y : Nat) -> AdditiveComm.powOp x y n
end

end

(* Laws of exponents, as laws of powers in the multiplicative monoid.  Each
   proof names the submodule of laws it uses with a local module. *)
module Exponents where

abstract def powPlus : forall (x : Nat) (m : Nat) (n : Nat) ->
    Eq (pow x (plus m n)) (mult (pow x m) (pow x n)) :=
  fun (x : Nat) (m : Nat) (n : Nat) ->
    let module P := Multiplicative.Power in P.powPlus x m n end
end

abstract def powMult : forall (x : Nat) (m : Nat) (n : Nat) ->
    Eq (pow x (mult m n)) (pow (pow x n) m) :=
  fun (x : Nat) (m : Nat) (n : Nat) ->
    let module P := Multiplicative.Power in P.powMult x m n end
end

abstract def powOfProduct : forall (x : Nat) (y : Nat) (n : Nat) ->
    Eq (pow (mult x y) n) (mult (pow x n) (pow y n)) :=
  fun (x : Nat) (y : Nat) (n : Nat) -> MultiplicativeComm.powOp x y n
end

(* [x] to the fourth is the square of its square: [mult 2 2] computes to
   [4]. *)
abstract def fourthPower : forall (x : Nat) -> Eq (pow x 4) (pow (pow x 2) 2) :=
  fun (x : Nat) -> let module P := Multiplicative.Power in P.powMult x 2 2 end
end

end

(* Iteration, as powers in the composition monoid, compared pointwise. *)
module Iteration where

(* Iterating [m + n] times is iterating [n] times, then [m] times. *)
abstract def iterPlus : forall (f : Endo) (m : Nat) (n : Nat) ->
    Pointwise (Composition.pow f (plus m n)) (compose (Composition.pow f m) (Composition.pow f n)) :=
  fun (f : Endo) (m : Nat) (n : Nat) -> Composition.Power.powPlus f m n
end

(* Iterating [m * n] times is iterating [n] times, [m] times over. *)
abstract def iterMult : forall (f : Endo) (m : Nat) (n : Nat) ->
    Pointwise (Composition.pow f (mult m n)) (Composition.pow (Composition.pow f n) m) :=
  fun (f : Endo) (m : Nat) (n : Nat) -> Composition.Power.powMult f m n
end

end

(* A monoid built here, from a partial application of the unit: the setoid
   of numbers is fixed, and the operation and its laws come later.  It is
   addition again, so its powers agree with [Additive]'s. *)
module NatMonoid := Monoid Nat Eq refl sym trans

module Sums := NatMonoid plus plusCongBoth 0 plusAssoc refl plusZero

eval Sums.pow 6 3

(* In the maximum monoid every positive power of [x] is [x]: the first is
   [max x 0], and each further factor is absorbed by [maxIdem].  The step
   names its rewriting under [max x] in a local module, which opens the
   congruence laws of the instance. *)
abstract def maxPowSucc : forall (x : Nat) (n : Nat) -> Eq (Maximum.pow x (succ n)) x :=
  fun (x : Nat) (n : Nat) ->
    rec n return k . Eq (Maximum.pow x (succ k)) x
    | zero => maxZero x
    | succ p, ih =>
        let power := Maximum.pow x (succ p);
            module L where
              open Maximum.Cong use (congRight)
              (* One more factor [x] in front of a power that is already [x]. *)
              def front : Eq (max x power) (max x x) := congRight x power x ih end
            end
        in trans (max x power) (max x x) x L.front (maxIdem x)
        end
    end
end

(* Closed instances normalize to [true]. *)
eval Unfold.additivePow 3 4

eval Scaling.multPlusRight 2 3 2

eval Scaling.multAssocPow 2 3 2

eval Scaling.multPlusLeft 2 3 4

eval Exponents.powPlus 2 1 3

eval Exponents.powMult 2 2 2

eval Exponents.powOfProduct 2 2 2

eval Exponents.fourthPower 2

eval Iteration.iterPlus (fun (x : Nat) -> succ x) 2 3 4

eval maxPowSucc 5 3

end
