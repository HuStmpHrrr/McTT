(* A client of [Prelude::Data::Vec] and [Prelude::Data::Vec::Properties]: small
   vectors of numbers are built, mapped, zipped, appended, split, reversed,
   folded, read and summed, and
   closed instances of the laws normalize to [true].  Index bounds on closed
   numbers compute to [True], so [true] proves them. *)
module Vectors where

import Prelude::Arith::Plus use (plus)
import Prelude::Arith::Mult use (mult)
import Prelude::Arith::Order use (Lt)
import Prelude::Data::Vec as V
import Prelude::Data::Vec::Properties use (sumVec)
open Prelude::Data::Vec::Properties.Nth use (nthMap; nthReplicate; nthAppendLeft; nthAppendRight; nthTabulate; nthZipWith; lastSnoc; nthReverse)
open Prelude::Data::Vec::Properties.Sums use (sumReplicate; sumAppend; sumMapPlus; sumMapScale; sumZipWithPlus; foldlPlus; sumSnoc; sumInitLast; sumReverse; sumTabulate)
open Prelude::Data::Vec::Properties.Slices use (takeAppend; dropAppend; appendTakeDrop)
open Prelude::Data::Vec::Properties.Tests use (allbSound; allbComplete; anybSound)

(* Vectors of numbers. *)
module NV := V 0l Nat

(* The vector [1, 2, 3]. *)
def oneTwoThree : NV.Vec 3 :=
  NV.cons 2 1 (NV.cons 1 2 (NV.cons 0 3 (NV.nil)))
end

(* The vector [4, 5]. *)
def fourFive : NV.Vec 2 :=
  NV.cons 1 4 (NV.cons 0 5 (NV.nil))
end

def square (x : Nat) : Nat := mult x x end

eval sumVec 3 oneTwoThree

eval NV.head 2 oneTwoThree

eval NV.nth 3 oneTwoThree 2 true

eval sumVec 2 (NV.tail 2 oneTwoThree)

eval sumVec 3 (NV.map Nat square 3 oneTwoThree)

eval NV.nth 5 (NV.append 3 2 oneTwoThree fourFive) 3 true

eval sumVec 5 (NV.append 3 2 oneTwoThree fourFive)

eval sumVec 4 (NV.replicate 4 6)

(* The length of a vector, as a right fold. *)
eval NV.foldr Nat (fun (a : Nat) (b : Nat) -> succ b) 0 5
       (NV.append 3 2 oneTwoThree fourFive)

(* A proof of a closed equation normalizes to [true], of type [True]. *)
eval sumReplicate 4 6

eval sumAppend 3 2 oneTwoThree fourFive

eval nthMap 0l Nat square 3 oneTwoThree 1 true

eval nthReplicate 4 6 3 true

eval nthAppendLeft 3 2 oneTwoThree fourFive 1 true true

eval nthAppendRight 3 2 oneTwoThree fourFive 1 true

(* The vector [1, 2, 3, 4, 5]. *)
def oneToFive : NV.Vec 5 := NV.append 3 2 oneTwoThree fourFive end

(* [0, 1, 4, 9], tabulated. *)
eval NV.nth 4 (NV.tabulate square 4) 3 true

eval sumVec 4 (NV.tabulate square 4)

(* The elementwise products of [1, 2] and [4, 5], summed: [1 * 4 + 2 * 5]. *)
eval sumVec 2 (NV.zipWith Nat Nat mult 2 (NV.take 2 1 oneTwoThree) fourFive)

(* A left fold builds the digits [1, 2, 3] into the number 123. *)
eval NV.foldl Nat (fun (b : Nat) (a : Nat) -> plus (mult 10 b) a) 0 3 oneTwoThree

eval NV.last 4 oneToFive

eval NV.last 3 (NV.snoc 3 oneTwoThree 7)

eval sumVec 4 (NV.init 4 oneToFive)

(* [reverse] puts 5 first and 1 last. *)
eval NV.head 4 (NV.reverse 5 oneToFive)

eval NV.last 4 (NV.reverse 5 oneToFive)

eval NV.nth 3 (NV.take 3 2 oneToFive) 2 true

eval NV.nth 2 (NV.drop 3 2 oneToFive) 0 true

(* Tests with the identity: [allb] is 1 on [1, ..., 5] and 0 on [0, 1, 2, 3];
   [anyb] is 1 on [0, 0, 9] and 0 on [0, 0, 0]. *)
eval NV.allb (fun (x : Nat) -> x) 5 oneToFive

eval NV.allb (fun (x : Nat) -> x) 4 (NV.cons 3 0 oneTwoThree)

eval NV.anyb (fun (x : Nat) -> x) 3 (NV.snoc 2 (NV.replicate 2 0) 9)

eval NV.anyb (fun (x : Nat) -> x) 3 (NV.replicate 3 0)

(* Closed instances of the new laws. *)
eval nthTabulate square 4 3 true

eval nthZipWith 0l Nat Nat mult 2 (NV.take 2 1 oneTwoThree) fourFive 1 true

eval nthReverse 5 oneToFive 1 true true

eval takeAppend 3 2 oneTwoThree fourFive 2 true

eval dropAppend 3 2 oneTwoThree fourFive 1 true

eval appendTakeDrop 3 2 oneToFive 4 true

eval lastSnoc 3 oneTwoThree 7

eval sumMapPlus 2 3 oneTwoThree

eval sumMapScale 3 3 oneTwoThree

eval sumZipWithPlus 2 fourFive (NV.tail 2 oneTwoThree)

eval foldlPlus 4 3 oneTwoThree

eval sumSnoc 3 oneTwoThree 7

eval sumInitLast 4 oneToFive

eval sumReverse 5 oneToFive

eval sumTabulate square 4

(* [allbSound] gives, at index 2, a proof of [Lt 0 3], which is [true]. *)
eval allbSound 0l Nat (fun (x : Nat) -> x) 5 oneToFive true 2 true

(* Every element of [replicate 4 3] is 3, so [Lt 0 3], that is [True], holds
   at every index. *)
eval allbComplete 0l Nat (fun (x : Nat) -> x) 4 (NV.replicate 4 3)
       (fun (i : Nat) (h : Lt i 4) -> true)

(* [anybSound] is eliminated into [Nat] to recover the index it found. *)
eval anybSound 0l Nat (fun (x : Nat) -> x) 3 (NV.snoc 2 (NV.replicate 2 0) 9) true Nat
       (fun (i : Nat) (h : Lt i 3) (q : Lt 0 (NV.snoc 2 (NV.replicate 2 0) 9 i h)) -> i)

end
