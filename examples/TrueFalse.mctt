(* The true proposition [⊤], with its proof [true], and the false
   proposition [⊥] with [exfalso].  A proof normalizes to [⋆]. *)
module TrueFalse where

import Prelude›Builtin›Nat

eval true

(* A function into a proposition is a proof, so it normalizes to ⋆. *)
eval λ (u : ⊤) → u

eval λ (f : ⊥) → exfalso f return ℕ

end
