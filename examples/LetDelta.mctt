module LetDelta where

def Nary (n : ℕ) : Type@0 ≔
  rec n return y . Type@0
  | zero ⇒ ℕ
  | succ m, r ⇒ ∀ (a : ℕ) → r
  end
end

(* Checking [f] against [Nary n], and applying it to three arguments, both
   need [n] to be [3]. *)
eval let n : ℕ ≔ 3;
         f : Nary n ≔ λ (a : ℕ) (b : ℕ) (c : ℕ) → a
     in
       f 1 2 3
     end : ℕ

end
