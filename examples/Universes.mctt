(* Universe polymorphism with first-class levels.

   The elements of [Level] are the literals [0l], [1l], …, the operations
   [succl] and [maxl], and whatever a term of type [Level] computes to;
   [Level] itself is in no universe, and a level is computed only from
   other levels.  [Type@{t}] is the small universe at the level [t], so a
   level-polymorphic definition is a function of a [Level], and a
   level-polymorphic module an ordinary parametrized module.  Above every
   universe at a finite level sit those at [ω] and [ω+n], [Type@ω] and
   [Type@{ω+n}], with the shorthand [Type@nL]. *)
module Universes where

import Prelude›Builtin›Nat use (zero; succ)

(* The identity, polymorphic in the level of its type. *)
def id (u : Level) (A : Type@{u}) (a : A) : A ≔ a end

eval id 1l Type@0 ℕ

(* A small universe is in the next one up, and cumulativity lifts it to any
   larger level — here to the join with the successor. *)
def lift (u : Level) (v : Level) : Type@{maxl (succl u) v} ≔ Type@{u} end

(* Levels normalize: a level is a constant and a set of atoms with offsets,
   so [maxl v (maxl 1l u)] and [maxl (maxl 1l v) u] are the same level. *)
def atoms (u : Level) (v : Level) : Type@{succl (maxl (maxl 1l v) u)} ≔
  Type@{maxl v (maxl 1l u)}
end

eval atoms

(* A module may take a level parameter like any other. *)
module Poly (u : Level) (A : Type@{u}) where

def self (a : A) : A ≔ a end

def Dom : Type@{u} ≔ A end

end

open Poly 0l ℕ use (self; Dom)

eval self 3

eval Dom

(* A function type of small types is small at their level, even when the
   level is a variable: [Endo u A] is in [Type@{u}], and a function between
   two universes is in the one at their join. *)
def Endo (u : Level) (A : Type@{u}) : Type@{u} ≔ ∀ (a : A) → A end

def Arr (u : Level) (v : Level) (A : Type@{u}) (B : Type@{v}) :
    Type@{maxl u v} ≔
  ∀ (a : A) → B
end

eval Endo 0l ℕ

(* An unannotated [let] gets the principal type, the small universe. *)
def LetEndo (u : Level) (A : Type@{u}) : Type@{u} ≔
  let e ≔ ∀ (a : A) → A in e end
end

eval λ (u : Level) (A : Type@{u}) → ∀ (a : A) → A

(* A codomain whose level mentions the bound variable has no finite level
   to be in: the type of all universes at finite levels is at [ω]. *)
eval ∀ (u : Level) → Type@{u}

(* The universe at [ω] holds every universe at a finite level. *)
def small (u : Level) : Type@ω ≔ Type@{u} end

(* Every spelling of a universe level.  Finite: a bare numeral, the level
   literal [<n>l], or any level term in braces.  At [ω] and above: [ω] or
   [omega], bare or braced, [ω+n] braced, and the shorthand [<n>L]. *)
eval Type@2

eval Type@2l

eval Type@{2l}

eval Type@ω

eval Type@ω

eval Type@{ω}

eval Type@{ω+2}

eval Type@2L

end
