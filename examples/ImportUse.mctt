(* Opening a module: [open Impl as I] names it [I], and
   [open Impl use (exposed)] declares [exposed] here; [Impl.secret] stays
   private. *)
module ImportUse where

module Impl where

private def secret : ℕ ≔ 3 end

def exposed : ℕ ≔ succ secret end

end

open Impl as I

open Impl use (exposed)

def sum : ∀ (x : ℕ) (y : ℕ) → ℕ ≔
  λ (x : ℕ) (y : ℕ) →
    rec x return z . ℕ | zero ⇒ y | succ p, r ⇒ succ r end
end

eval sum I.exposed exposed : ℕ

end
