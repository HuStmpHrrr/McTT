(* An [abstract] definition is checked but never unfolds, so [double four]
   is stuck at [four]. *)
module DefAbstract where

import Prelude›Builtin›Nat use (zero; succ)

def double : ∀ (x : ℕ) → ℕ ≔
  λ (x : ℕ) →
    elim x at y -> ℕ | zero ⇒ 0 | succ p, r ⇒ succ (succ r) end
end

abstract def four : ℕ ≔ double 2 end

eval double four : ℕ

(* The type of an unascribed [eval] is inferred. *)
eval double four

end
