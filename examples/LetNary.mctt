(* N-ary functions on numbers, defined and applied inside one [let]. *)
module LetNary where

import Prelude›Builtin›Nat use (zero; succ)

eval let Nary : ∀ (n : ℕ) → Type@0 ≔
       λ (n : ℕ)
         → elim n at y -> Type@0
           | zero ⇒ ℕ
           | succ m, r ⇒ ∀ (a : ℕ) → r
           end;

     toNat : ∀ (f : Nary 0) → ℕ ≔
       λ (f : ℕ) → f;

     appNary : ∀ (n : ℕ) (f : Nary (succ n)) (arg : ℕ) → Nary n ≔
       λ (n : ℕ)
         (f : elim succ n at y -> Type@0
              | zero ⇒ ℕ
              | succ m, r ⇒ ∀ (a : ℕ) → r
              end)
         (arg : ℕ)
         → f arg;

     n : ℕ ≔ 3;

     f : Nary n ≔
       let add : ∀ (a : ℕ) (b : ℕ) → ℕ ≔
             λ (a : ℕ)
               (b : ℕ)
               → elim a at y -> ℕ
                 | zero ⇒ b
                 | succ m, r ⇒ succ r
                 end
       in
         λ (a : ℕ) (b : ℕ) (c : ℕ) → add a (add b c)
       end

  in
    ((elim n at y -> (∀ (g : Nary y) → ℕ)
         | zero ⇒ toNat
         | succ m, r ⇒ λ (g : Nary (succ m)) → r (appNary m g (succ m))
         end) f)
  end : ℕ
  (*
    Basically:
    f 3 2 1
    where
    f x y z = x + (y + z)
  *)

end
