(* Numbers: doubling, and a predecessor in a nested module. *)
module Lib›Num where

import Prelude›Builtin›Nat use (zero; succ)

def double : ∀ (x : ℕ) → ℕ ≔
  λ (x : ℕ) → elim x return y . ℕ | zero ⇒ 0 | succ p, r ⇒ succ (succ r) end
end

module Ops where

def pred : ∀ (x : ℕ) → ℕ ≔
  λ (x : ℕ) → elim x return y . ℕ | zero ⇒ 0 | succ p, r ⇒ p end
end

end

end
