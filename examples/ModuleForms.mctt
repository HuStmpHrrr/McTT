(* The forms of module declarations: parameterized modules, aliases, dotted
   names, opens and local modules with a body. *)
module ModuleForms where

(* A parameterized module, and an alias of one of its instances *)
module Iter (A : Type@0) where
  def twice (f : ∀ (x : A) → A) (x : A) : A ≔ f (f x) end
end

module NatIter ≔ Iter ℕ

eval NatIter.twice (λ (x : ℕ) → succ x) 0

(* A dotted declaration: [Num] holds [Ops] *)
module Num.Ops (k : ℕ) where
  def add (n : ℕ) : ℕ ≔
    rec n return y . ℕ | zero ⇒ k | succ p, r ⇒ succ r end
  end
end

eval Num.Ops.add 2 3

(* An open binds names in the frame that makes it *)
open Num.Ops as O

eval O.add 1 1

(* A local module with a body: each entry sees the earlier ones, and an
   open inside it declares private definitions of the members it uses *)
eval let module L (n : ℕ) where
       module Inner where def m : ℕ ≔ succ n end end
       open Inner use (m)
       def doubled : ℕ ≔ Num.Ops.add m m end
     end in
       L.doubled 2
     end : ℕ

end
