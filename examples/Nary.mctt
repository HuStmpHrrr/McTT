module Nary where

(* Functions of any number of arguments over a type [A]. *)
module Arity (A : Type@0) where

  (* [Fn n] takes [n] arguments of type [A] and returns an [A]. *)
  def Fn (n : ℕ) : Type@0 ≔
    rec n return y . Type@0
    | zero ⇒ A
    | succ m, r ⇒ ∀ (a : A) → r
    end
  end

  (* [fold op n acc] takes [n] more arguments, combining each into [acc]. *)
  def fold (op : ∀ (a : A) (b : A) → A) (n : ℕ) : ∀ (acc : A) → Fn n ≔
    rec n return y . (∀ (acc : A) → Fn y)
    | zero ⇒ λ (acc : A) → acc
    | succ m, r ⇒ λ (acc : A) (a : A) → r (op acc a)
    end
  end

end

def add (a : ℕ) (b : ℕ) : ℕ ≔
  rec a return y . ℕ
  | zero ⇒ b
  | succ p, r ⇒ succ r
  end
end

(* The sum of [n] numbers, as a function of [n] arguments. *)
def sum (n : ℕ) : Arity.Fn ℕ n ≔ Arity.fold ℕ add n 0 end

eval sum 3 1 2 3 : ℕ

eval let module N ≔ Arity ℕ;
         sumFour : N.Fn 4 ≔ sum 4
     in sumFour 1 2 3 4
     end

end
