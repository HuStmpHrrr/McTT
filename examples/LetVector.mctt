module LetVector where

eval
  let Vec : ∀ (A : Type@0) (n : ℕ) → Type@2 ≔
        λ (A : Type@0) (n : ℕ) → ∀ (C : ∀ (l : ℕ) → Type@1) (nil : C 0) (cons : ∀ (l : ℕ) (a : A) (r : C l) → C (succ l)) → C n;

      nil : ∀ (A : Type@0) → Vec A 0 ≔
        λ (A : Type@0)
          (C : ∀ (l : ℕ) → Type@1)
          (nil : C 0)
          (cons : ∀ (l : ℕ) (a : A) (r : C l) → C (succ l)) →
          nil;

      cons : ∀ (A : Type@0) (n : ℕ) (head : A) (tail : Vec A n) → Vec A (succ n) ≔
        λ (A : Type@0)
          (n : ℕ)
          (head : A)
          (tail : ∀ (C : ∀ (l : ℕ) → Type@1) (nil : C 0) (cons : ∀ (l : ℕ) (a : A) (r : C l) → C (succ l)) → C n)
          (C : ∀ (l : ℕ) → Type@1)
          (nil : C 0)
          (cons : ∀ (l : ℕ) (a : A) (r : C l) → C (succ l)) →
          cons n head (tail C nil cons);

      vecRec : ∀ (A : Type@0) (n : ℕ) (vec : Vec A n) (C : ∀ (l : ℕ) → Type@1) (nil : C 0) (cons : ∀ (l : ℕ) (a : A) (r : C l) → C (succ l)) → C n ≔
        λ (A : Type@0) (n : ℕ) (vec : ∀ (C : ∀ (l : ℕ) → Type@1) (nil : C 0) (cons : ∀ (l : ℕ) (a : A) (r : C l) → C (succ l)) → C n) (C : ∀ (l : ℕ) → Type@1) (nil : C 0) (cons : ∀ (l : ℕ) (a : A) (r : C l) → C (succ l)) → vec C nil cons

  in
  let totalHead : ∀ (A : Type@0) (n : ℕ) (vec : Vec A (succ n)) → A ≔
        λ (A : Type@0) (n : ℕ) (vec : Vec A (succ n)) →
          vecRec A (succ n) vec (λ (l : ℕ) → rec l return r . Type@0 | zero ⇒ ℕ | succ l, r ⇒ A end) 0 (λ (l : ℕ) (a : A) (r : rec l return r . Type@0 | zero ⇒ ℕ | succ l, r ⇒ A end) → a);

      vec : Vec (∀ (n : ℕ) → ℕ) 3 ≔
        cons (∀ (n : ℕ) → ℕ) 2
             (λ (n : ℕ) → succ (succ (succ n)))
             (cons (∀ (n : ℕ) → ℕ) 1
                   (λ (n : ℕ) → succ n)
                   (cons (∀ (n : ℕ) → ℕ) 0
                         (λ (n : ℕ) → succ (succ n))
                         (nil (∀ (n : ℕ) → ℕ))
                   )
             )
  in
  totalHead ((∀ (n : ℕ) → ℕ)) 2 vec 4
  end
  end : ℕ
  (*
    When
      vec = [λ x → 3 + x; λ x → 1 + x; λ x → 2 + x]
    we get its head (λ x → 3 + x) and applies it to 4.
  *)

end
