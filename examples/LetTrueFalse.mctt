(* Local definitions at [⊤] and at a function out of [⊥]. *)
module LetTrueFalse where

import Prelude›Builtin›Nat

(* A local definition of each of [⊤] and [⊥ → ℕ]; the body only
   uses the first, a proof, which normalizes to [⋆]. *)
eval let t : ⊤ ≔ true;
         f : ∀ (x : ⊥) → ℕ ≔ λ (x : ⊥) → exfalso x return ℕ
     in t
     end

end
