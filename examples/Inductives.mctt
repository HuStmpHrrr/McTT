(* Inductive types: declared in a unit, built by their constructors and
   taken apart by the eliminator elim, whose branches compute on a
   constructor.

   Where a parameter is written decides what it is.  Left of ":", a
   uniform parameter: fixed for the whole type, so a recursive argument
   passes it back unchanged, and the eliminator reads it off the
   scrutinee's type (the motive does not bind it, nor do the branches).
   Right of ":", bound by the type in front of its sort, a non-uniform
   parameter: it may vary, so a recursive argument may give it a new
   value, the motive binds it before the scrutinee, a branch binds the
   constructor's value of it, and each hypothesis is at its recursive
   argument's own value.  [Climb] at the end has one. *)
module Inductives where

import Prelude›Builtin›Nat use (zero; succ)

(* Lists: one uniform parameter, [A], one recursive argument, at [A]
   unchanged.  [List] is also a module over [A]: its members are the
   constructors [List.nil] and [List.cons], and the recursor [List.rec]. *)
inductive List (A : Type@0) : Type@0 where
| nil
| cons (x : A) (xs : List A)
end

(* The motive binds the scrutinee, not [A]; a branch, the constructor's
   arguments and, after the comma, the induction hypotheses. *)
def length (A : Type@0) (l : List A) : ℕ :=
  elim l return z . ℕ
  | nil ⇒ 0
  | cons x xs, r ⇒ succ r
  end
end

def append (A : Type@0) (l : List A) (m : List A) : List A :=
  elim l return z . List A
  | nil ⇒ m
  | cons x xs, r ⇒ List.cons A x r
  end
end

eval length ℕ (append ℕ (List.cons ℕ 1 (List.cons ℕ 2 (List.nil ℕ)))
                (List.cons ℕ 3 (List.nil ℕ)))
eval append ℕ (List.cons ℕ 1 (List.nil ℕ)) (List.cons ℕ 2 (List.nil ℕ))

(* The recursor, a member generated with the constructors: the eliminator
   as a function, its motive into a small universe at a finite level.
   Its type is the one stated here. *)
def recType : ∀ (A : Type@0) (u : Level) (P : ∀ (l : List A) → Type@{u})
    (bnil : P (List.nil A))
    (bcons : ∀ (x : A) (xs : List A) (r : P xs) → P (List.cons A x xs))
    (l : List A) → P l :=
  List.rec
end

def count (A : Type@0) (l : List A) : ℕ :=
  List.rec A 0l (λ (l : List A) → ℕ) 0
    (λ (x : A) (xs : List A) (r : ℕ) → succ r) l
end

eval count ℕ (List.cons ℕ 1 (List.cons ℕ 2 (List.nil ℕ)))

(* A stuck eliminator: its scrutinee is a variable. *)
eval λ (l : List ℕ) → length ℕ (List.cons ℕ 0 l)

(* An inductive type is also a module, over its uniform parameters, whose
   members are its constructors: [List.cons ℕ] is [(List ℕ).cons], and an
   open declares them here.  As a term, [List] is the type. *)
eval (List ℕ).cons 0 (List ℕ).nil

open List use (nil; cons)

eval cons ℕ 1 (nil ℕ)

(* Options: no recursive argument. *)
inductive Option (A : Type@0) : Type@0 where
| none
| some (x : A)
end

def getOr (A : Type@0) (d : A) (o : Option A) : A :=
  elim o return z . A
  | none ⇒ d
  | some x ⇒ x
  end
end

eval getOr ℕ 0 (Option.some ℕ 5)
eval getOr ℕ 0 (Option.none ℕ)

(* Binary trees: two recursive arguments, so two hypotheses. *)
inductive Tree (A : Type@0) : Type@0 where
| leaf
| node (l : Tree A) (x : A) (r : Tree A)
end

def plus (m : ℕ) (n : ℕ) : ℕ :=
  elim m return z . ℕ
  | zero ⇒ n
  | succ k, r ⇒ succ r
  end
end

def size (A : Type@0) (t : Tree A) : ℕ :=
  elim t return z . ℕ
  | leaf ⇒ 0
  | node l x r, hl hr ⇒ succ (plus hl hr)
  end
end

eval size ℕ
  (Tree.node ℕ (Tree.node ℕ (Tree.leaf ℕ) 1 (Tree.leaf ℕ)) 2 (Tree.leaf ℕ))

(* Dependent pairs: the type of the second component depends on the
   first, and the motive on the pair. *)
inductive Sigma (A : Type@0) (B : ∀ (x : A) → Type@0) : Type@0 where
| pair (a : A) (b : B a)
end

def fst (A : Type@0) (B : ∀ (x : A) → Type@0) (p : Sigma A B) : A :=
  elim p return z . A
  | pair a b ⇒ a
  end
end

(* The branch's type is [B (fst A B (Sigma.pair A B a b))], which computes to
   [B a]. *)
def snd (A : Type@0) (B : ∀ (x : A) → Type@0) (p : Sigma A B) : B (fst A B p) :=
  elim p return z . B (fst A B z)
  | pair a b ⇒ b
  end
end

eval snd ℕ (λ (x : ℕ) → ℕ) (Sigma.pair ℕ (λ (x : ℕ) → ℕ) 1 2)

(* A non-uniform parameter: the type binds [n] in front of its sort, and a
   recursive argument gives it a new value, [succ n].  The motive binds it
   ([m]) before the scrutinee; a branch binds the constructor's value of
   it ([m]), then the arguments ([r]), then the hypothesis ([h]), which is
   about [r : Climb (succ m)]. *)
inductive Climb : ∀ (n : ℕ) → Type@0 where
| stop
| step (r : Climb (succ n))
end

def steps (n : ℕ) (c : Climb n) : ℕ :=
  elim c return m z . ℕ
  | stop m ⇒ 0
  | step m r, h ⇒ succ h
  end
end

eval steps 0 (Climb.step 0 (Climb.step 1 (Climb.stop 2)))

(* The recursor binds the non-uniform parameters too: in the motive, in the
   branches, and before the scrutinee. *)
def climbs (n : ℕ) (c : Climb n) : ℕ :=
  Climb.rec 0l (λ (m : ℕ) (z : Climb m) → ℕ) (λ (m : ℕ) → 0)
    (λ (m : ℕ) (r : Climb (succ m)) (h : ℕ) → succ h) n c
end

eval climbs 0 (Climb.step 0 (Climb.stop 1))


(* Function-shaped recursive arguments.  An argument may be a function
   into the type: [Self] then occurs only to the right of the arrows.  Its
   hypothesis is a function too: the motive at each of the function's
   values.

   Brouwer ordinals: [lim f] is the limit of [f 0], [f 1], ..., and its
   hypothesis [h] gives the result at [f n] for each [n]. *)
inductive Ord : Type@0 where
| base
| next (o : Ord)
| lim (f : ∀ (n : ℕ) → Ord)
end

(* The finite ordinals, and their limit, the first infinite one. *)
def fin (n : ℕ) : Ord :=
  elim n return z . Ord
  | zero ⇒ Ord.base
  | succ k, r ⇒ Ord.next r
  end
end

def omg : Ord := Ord.lim (λ (n : ℕ) → fin n) end

(* The [k]-th approximation of an ordinal: a limit is approximated by the
   [k]-th ordinal it is the limit of.  On [omg] it is [k]. *)
def approx (o : Ord) (k : ℕ) : ℕ :=
  elim o return z . ℕ
  | base ⇒ 0
  | next p, r ⇒ succ r
  | lim f, h ⇒ h k
  end
end

eval approx omg 3
eval approx (Ord.next omg) 2

(* The eliminator on a limit computes the hypothesis at each value on
   demand: here only at [f 1]. *)
eval λ (f : ∀ (n : ℕ) → Ord) → approx (Ord.lim f) 1

(* The recursor's argument for [lim] takes the hypothesis as a function. *)
def approxRec (o : Ord) : ℕ :=
  Ord.rec 0l (λ (o : Ord) → ℕ) 0 (λ (p : Ord) (r : ℕ) → succ r)
    (λ (f : ∀ (n : ℕ) → Ord) (h : ∀ (n : ℕ) → ℕ) → h 2) o
end

eval approxRec (Ord.lim (λ (n : ℕ) → Ord.next (fin n)))

(* The same type with the function type behind a definition: an argument
   that is not a recursive argument as written is classified on its normal
   form, [∀ (n : ℕ) → OrdA]. *)
def Arr (X : Type@0) : Type@0 := ∀ (n : ℕ) → X end

inductive OrdA : Type@0 where
| base
| next (o : OrdA)
| lim (f : Arr OrdA)
end

def approxA (o : OrdA) (k : ℕ) : ℕ :=
  elim o return z . ℕ
  | base ⇒ 0
  | next p, r ⇒ succ r
  | lim f, h ⇒ h k
  end
end

eval approxA (OrdA.lim (λ (n : ℕ) → OrdA.next (OrdA.next OrdA.base))) 0

(* W-types: well-founded trees, a node labelled [a : A] with a child for
   each [b : B a].  The natural numbers are the W-type of two labels, [zr]
   with no child and [sc] with one. *)
inductive W (A : Type@0) (B : ∀ (a : A) → Type@0) : Type@0 where
| sup (a : A) (f : ∀ (b : B a) → W A B)
end

inductive Label : Type@0 where
| zr
| sc
end

def Arity (l : Label) : Type@0 :=
  elim l return z . Type@0
  | zr ⇒ ⊥
  | sc ⇒ ⊤
  end
end

def WNat : Type@0 := W Label Arity end

def wzero : WNat :=
  W.sup Label Arity Label.zr (λ (x : ⊥) → exfalso x return z . WNat)
end

def wsucc (n : WNat) : WNat := W.sup Label Arity Label.sc (λ (x : ⊤) → n) end

(* The number a tree stands for: at [sc], one more than at its child. *)
def toNat (w : WNat) : ℕ :=
  elim w return z . ℕ
  | sup a f, h ⇒
      (elim a return y . ∀ (h : ∀ (b : Arity y) → ℕ) → ℕ
       | zr ⇒ λ (h : ∀ (b : ⊥) → ℕ) → 0
       | sc ⇒ λ (h : ∀ (b : ⊤) → ℕ) → succ (h ⋆)
       end) h
  end
end

eval toNat (wsucc (wsucc (wsucc wzero)))

(* Its number of nodes, by the recursor. *)
def wsize (w : WNat) : ℕ :=
  W.rec Label Arity 0l (λ (w : WNat) → ℕ)
    (λ (a : Label) (f : ∀ (b : Arity a) → WNat) (h : ∀ (b : Arity a) → ℕ) →
       succ
         ((elim a return y . ∀ (h : ∀ (b : Arity y) → ℕ) → ℕ
           | zr ⇒ λ (h : ∀ (b : ⊥) → ℕ) → 0
           | sc ⇒ λ (h : ∀ (b : ⊤) → ℕ) → h ⋆
           end) h)) w
end

eval wsize (wsucc (wsucc wzero))

(* A nested function shape: a node has a subtree at every pair of
   numbers, and its hypothesis is a function of two arguments. *)
inductive Grid : Type@0 where
| cell (k : ℕ)
| node (f : ∀ (n : ℕ) (m : ℕ) → Grid)
end

def sample (g : Grid) : ℕ :=
  elim g return z . ℕ
  | cell k ⇒ k
  | node f, h ⇒ plus (h 0 1) (h 2 3)
  end
end

def sums : Grid := Grid.node (λ (n : ℕ) (m : ℕ) → Grid.cell (plus n m)) end

eval sample sums
eval sample (Grid.node (λ (n : ℕ) (m : ℕ) → sums))

end
